{
  "custom": {
    "status": "",
    "ok": true,
    "armed": "",
    "rev": 0,
    "name": "",
    "delModel": null
  },
  "params": {},
  "propConfig": {},
  "props": {
    "defaultSize": {
      "width": 560,
      "height": 460
    }
  },
  "root": {
    "type": "ia.container.flex",
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "column",
      "style": {
        "padding": "14px 18px",
        "gap": "9px",
        "overflow": "hidden",
        "backgroundColor": "var(--md-panel, #1d232a)"
      }
    },
    "children": [
      {
        "type": "ia.display.label",
        "meta": {
          "name": "UploadHead"
        },
        "position": {
          "shrink": 0
        },
        "props": {
          "text": "Upload a model",
          "style": {
            "fontSize": "12px",
            "color": "var(--md-ink-quiet, #8b98a3)",
            "fontWeight": "bold",
            "letterSpacing": "1.2px",
            "textTransform": "uppercase"
          }
        }
      },
      {
        "type": "ia.display.label",
        "meta": {
          "name": "UploadHelp"
        },
        "position": {
          "shrink": 0
        },
        "props": {
          "text": "A binary STL (one part), a zip of STLs (one part per file, named from the file) or a STEP file (.step/.stp - parts from its assembly). Up to 50 MB. A model of the same name is replaced.",
          "style": {
            "fontSize": "12.5px",
            "color": "var(--md-ink-quiet, #8b98a3)",
            "whiteSpace": "normal",
            "lineHeight": "1.45"
          }
        }
      },
      {
        "type": "ia.input.text-field",
        "meta": {
          "name": "Name"
        },
        "position": {
          "shrink": 0
        },
        "props": {
          "placeholder": "Model name - leave empty to use the file name",
          "deferUpdates": false,
          "style": {
            "minHeight": "36px",
            "fontSize": "12.5px"
          }
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "type": "property",
              "config": {
                "path": "view.custom.name",
                "bidirectional": true
              }
            }
          }
        }
      },
      {
        "type": "ia.input.fileupload",
        "meta": {
          "name": "Upload"
        },
        "position": {
          "shrink": 0,
          "basis": "150px"
        },
        "props": {
          "supportedFileTypes": [
            "stl",
            "zip",
            "step",
            "stp"
          ],
          "fileSizeLimit": 50,
          "maxUploads": 1
        },
        "events": {
          "component": {
            "onFileReceived": {
              "type": "script",
              "scope": "G",
              "config": {
                "script": "\tfrom java.lang import Throwable\n\tname = self.view.custom.name\n\ttry:\n\t\tr = MachineDemo.cad.save(event.file.name, event.file.getBytes(), name)\n\texcept (Throwable, Exception) as e:\n\t\tself.view.custom.status = u\"Not stored: %s\" % e\n\t\tself.view.custom.ok = False\n\t\treturn\n\tself.view.custom.status = u\"%s %s - %s, %d part file(s). It is showing now.\" % (\n\t\tr[\"name\"], \"replaced\" if r[\"replaced\"] else \"stored\", r[\"kind\"].upper(), r[\"parts\"])\n\tself.view.custom.ok = True\n\tself.view.custom.rev = (self.view.custom.rev or 0) + 1\n\tself.view.custom.name = \"\"\n\tsystem.perspective.sendMessage(\"cadModelChanged\", payload={\"model\": r[\"name\"]}, scope=\"page\")\n"
              }
            }
          }
        }
      },
      {
        "type": "ia.display.label",
        "meta": {
          "name": "DeleteHead"
        },
        "position": {
          "shrink": 0
        },
        "props": {
          "text": "Delete an uploaded model",
          "style": {
            "fontSize": "12px",
            "color": "var(--md-ink-quiet, #8b98a3)",
            "fontWeight": "bold",
            "letterSpacing": "1.2px",
            "textTransform": "uppercase"
          }
        }
      },
      {
        "type": "ia.container.flex",
        "meta": {
          "name": "DeleteRow"
        },
        "position": {
          "shrink": 0
        },
        "props": {
          "direction": "row",
          "alignItems": "center",
          "style": {
            "gap": "10px"
          }
        },
        "children": [
          {
            "type": "ia.input.dropdown",
            "meta": {
              "name": "DelModel"
            },
            "position": {
              "grow": 1,
              "basis": "0px"
            },
            "props": {
              "placeholder": "Uploaded models",
              "style": {
                "minHeight": "38px",
                "fontSize": "12.5px"
              }
            },
            "propConfig": {
              "props.options": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "runScript(\"MachineDemo.cad.uploadedOptions\", 0, {view.custom.rev})"
                  }
                }
              },
              "props.value": {
                "binding": {
                  "type": "property",
                  "config": {
                    "path": "view.custom.delModel",
                    "bidirectional": true
                  }
                }
              }
            }
          },
          {
            "type": "ia.input.button",
            "meta": {
              "name": "Delete"
            },
            "position": {
              "shrink": 0,
              "basis": "190px"
            },
            "props": {
              "style": {
                "backgroundColor": "var(--md-well, #262e36)",
                "color": "var(--md-ink-mid, #cdd6dd)",
                "border": "1px solid var(--md-line-soft, #38424c)",
                "borderRadius": "7px",
                "fontWeight": "bold",
                "fontSize": "12.5px",
                "minHeight": "38px",
                "padding": "0 16px",
                "alignItems": "center"
              }
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "type": "expr",
                  "config": {
                    "expression": "if({view.custom.armed} != \"\" && {view.custom.armed} = {view.custom.delModel}, \"Press again to delete\", \"Delete\")"
                  }
                }
              }
            },
            "events": {
              "component": {
                "onActionPerformed": {
                  "type": "script",
                  "scope": "G",
                  "config": {
                    "script": "\tfrom java.lang import Throwable\n\tv = self.view.custom\n\tname = v.delModel\n\tif not name:\n\t\tv.status = u\"Choose an uploaded model to delete.\"\n\t\tv.ok = False\n\t\treturn\n\tif v.armed != name:\n\t\tv.armed = name\n\t\treturn\n\ttry:\n\t\tMachineDemo.cad.delete(name)\n\texcept (Throwable, Exception) as e:\n\t\tv.status = u\"Not deleted: %s\" % e\n\t\tv.ok = False\n\t\treturn\n\tv.armed = \"\"\n\tv.status = u\"%s deleted.\" % name\n\tv.ok = True\n\tv.rev = (v.rev or 0) + 1\n\tv.delModel = None\n\tsystem.perspective.sendMessage(\"cadModelChanged\", payload={\"deleted\": name}, scope=\"page\")\n"
                  }
                }
              }
            }
          }
        ]
      },
      {
        "type": "ia.display.label",
        "meta": {
          "name": "Status"
        },
        "position": {
          "shrink": 0
        },
        "props": {
          "style": {
            "fontSize": "12.5px",
            "whiteSpace": "normal",
            "lineHeight": "1.45"
          }
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "type": "property",
              "config": {
                "path": "view.custom.status"
              }
            }
          },
          "props.style.color": {
            "binding": {
              "type": "expr",
              "config": {
                "expression": "if({view.custom.ok}, \"var(--md-ink-mid, #cdd6dd)\", \"var(--md-fault-ink, #ff8d92)\")"
              }
            }
          }
        }
      },
      {
        "type": "ia.display.label",
        "meta": {
          "name": "Where"
        },
        "position": {
          "shrink": 0
        },
        "props": {
          "text": "Uploads are kept on the gateway in data/machine-demo-cad, outside the project.",
          "style": {
            "fontSize": "11.5px",
            "color": "var(--md-ink-quiet, #8b98a3)"
          }
        }
      }
    ]
  }
}