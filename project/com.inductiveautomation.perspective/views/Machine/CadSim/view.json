                    "script": "\tfrom java.lang import Throwable\n\tv = self.view.custom\n\ttry:\n\t\tMachineDemo.cad.simAck(1)\n\texcept (Throwable, Exception) as e:\n\t\tv.status = u\"Failed: %s\" % e\n\t\tv.ok = False\n\t\treturn\n\tv.status = u\"\"\n\tv.ok = True\n\tv.rev = (v.rev or 0) + 1\n"
