                "expression": "\"Robot: \" + {[MachineDemo]Robot/State} + \"   J2 \" + stringFormat(\"%.1f\", {[MachineDemo]Robot/J2_deg}) + \"  J3 \" + stringFormat(\"%.1f\", {[MachineDemo]Robot/J3_deg}) + \"  Lift \" + stringFormat(\"%.0f\", {[MachineDemo]Robot/Lift_mm}) + \" mm\""
              }
            }
          }
        }
      }
    ]
  }
}