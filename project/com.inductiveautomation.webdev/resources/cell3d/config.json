{
  "resource-type": "text-resource",
  "content-type": "text/html",
  "text": "<!doctype html>\n<html lang=\"en-AU\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, user-scalable=no\">\n<title>Palletising Cell \u2014 live 3D</title>\n<style>\n  /* Everything here is deliberately self-contained. No web fonts, no CDN:\n     the page has to render identically on a machine with no internet, which\n     is the normal condition for the panel this is designed for. */\n  :root {\n    color-scheme: dark;\n    --bg: #171b20;\n    --panel: rgba(29,35,42,.92);\n    --line: #2c343d;\n    --ink: #dde4e9;\n    --dim: #8b98a3;\n    --run: #46d07c;\n    --fault: #f0565e;\n    --warn: #eebf5e;\n    --info: #6cc4e8;\n    --mono: \"DejaVu Sans Mono\", \"Liberation Mono\", Consolas, \"Courier New\", monospace;\n  }\n  * { box-sizing: border-box; }\n  html, body { height: 100%; margin: 0; overflow: hidden; background: var(--bg); }\n  body {\n    font-family: \"Noto Sans\", \"Segoe UI\", system-ui, sans-serif;\n    color: var(--ink);\n    -webkit-tap-highlight-color: transparent;\n  }\n  canvas { display: block; touch-action: none; }\n\n  .hud { position: fixed; z-index: 5; }\n\n  .card {\n    background: var(--panel);\n    border: 1px solid var(--line);\n    border-radius: 9px;\n    backdrop-filter: blur(6px);\n  }\n  .card-h {\n    font-size: 10.5px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase;\n    color: var(--dim); padding: 8px 12px 6px; border-bottom: 1px solid var(--line);\n    display: flex; align-items: center; gap: 8px;\n  }\n  .card-b { padding: 9px 12px 11px; }\n\n  /* ---- top-left: line state ---- */\n  #state { top: 12px; left: 12px; width: 252px; }\n  .row { display: flex; align-items: baseline; gap: 8px; padding: 3px 0; font-size: 12.5px; }\n  .row .k { color: var(--dim); flex: 1; }\n  .row .v { font-family: var(--mono); font-variant-numeric: tabular-nums; font-size: 14px; color: var(--ink); }\n  .row .v.acc { color: #7ee2d2; }\n  .big { font-size: 19px !important; }\n\n  .pill {\n    display: inline-flex; align-items: center; gap: 6px;\n    font-size: 10.5px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase;\n    border-radius: 4px; padding: 3px 9px; border: 1px solid;\n  }\n  .pill.run   { background: #10331e; color: var(--run);   border-color: #1d5c35; }\n  .pill.idle  { background: #23292f; color: var(--dim);   border-color: #38424c; }\n  .pill.flt   { background: #3d1518; color: #ff8d92;      border-color: #7a2a2f; }\n  .pill.mode  { background: #14313e; color: var(--info);  border-color: #1e546c; }\n\n  /* ---- top-right: safety + faults ---- */\n  #safety { top: 12px; right: 12px; width: 232px; }\n  .sig { display: flex; align-items: center; gap: 9px; font-size: 12.5px; color: #b7c2ca; padding: 3.5px 0; }\n  .led { width: 10px; height: 10px; border-radius: 50%; flex: none; background: #3a434b; }\n  .led.on  { background: var(--run);   box-shadow: 0 0 6px rgba(70,208,124,.75); }\n  .led.bad { background: var(--fault); box-shadow: 0 0 7px rgba(240,86,94,.85); }\n  .led.wrn { background: var(--warn);  box-shadow: 0 0 6px rgba(238,191,94,.7); }\n\n  #faultbanner {\n    position: fixed; top: 12px; left: 50%; transform: translateX(-50%);\n    z-index: 8; display: none; align-items: center; gap: 11px;\n    background: rgba(61,21,24,.95); border: 1px solid #8c2830; border-radius: 9px;\n    padding: 10px 18px; color: #ffc2c5; font-size: 14px; font-weight: 600;\n    box-shadow: 0 6px 26px rgba(0,0,0,.5);\n    animation: pulse 1.6s ease-in-out infinite;\n  }\n  #faultbanner.show { display: flex; }\n  @keyframes pulse { 0%,100% { border-color:#8c2830 } 50% { border-color:#f0565e } }\n  @media (prefers-reduced-motion: reduce) { #faultbanner { animation: none } }\n\n  /* ---- bottom-right: pallet build ---- */\n  #pallets { bottom: 12px; right: 12px; width: 252px; }\n  .pal { padding: 7px 0; }\n  .pal + .pal { border-top: 1px solid var(--line); }\n  .pal-h { display: flex; align-items: baseline; gap: 8px; font-size: 12.5px; margin-bottom: 6px; }\n  .pal-h b { font-weight: 700; }\n  .pal-h .n { margin-left: auto; font-family: var(--mono); font-variant-numeric: tabular-nums; color: #7ee2d2; font-size: 14px; }\n  .bar { height: 7px; border-radius: 4px; background: #12161a; border: 1px solid var(--line); overflow: hidden; }\n  .bar i { display: block; height: 100%; background: linear-gradient(90deg,#2c7a4a,#46d07c); transition: width .35s ease; }\n  .layers { display: flex; gap: 3px; margin-top: 6px; }\n  .layers span { flex: 1; height: 5px; border-radius: 2px; background: #262e36; }\n  .layers span.done { background: var(--run); }\n  .layers span.part { background: var(--warn); }\n\n  /* ---- bottom-left: camera presets ---- */\n  #cams { bottom: 12px; left: 12px; display: flex; gap: 8px; flex-wrap: wrap; max-width: 60vw; }\n  .cam {\n    font: inherit; font-size: 12.5px; font-weight: 700; color: #cdd6dd;\n    background: rgba(38,46,54,.92); border: 1px solid #38424c; border-radius: 8px;\n    padding: 11px 15px; cursor: pointer; min-height: 42px;\n  }\n  .cam:hover { background: rgba(48,58,68,.95); }\n  .cam.active { background: #14313e; border-color: #1e546c; color: #9fdcf5; }\n  .cam:focus-visible { outline: 2px solid var(--info); outline-offset: 2px; }\n\n  /* ---- anchored 3D labels ---- */\n  .tag3d {\n    position: fixed; z-index: 4; transform: translate(-50%,-50%);\n    background: rgba(23,27,32,.86); border: 1px solid var(--line); border-radius: 6px;\n    padding: 4px 9px; font-size: 11.5px; color: #c8d2d9; white-space: nowrap;\n    pointer-events: none; font-variant-numeric: tabular-nums;\n  }\n  .tag3d b { font-family: var(--mono); color: #7ee2d2; font-weight: 400; }\n  .tag3d.bad { border-color: #7a2a2f; background: rgba(45,18,21,.9); color: #ffc2c5; }\n  .tag3d.bad b { color: #ff8d92; }\n\n  /* ---- link state ---- */\n  #link {\n    position: fixed; z-index: 6; bottom: 12px; left: 50%; transform: translateX(-50%);\n    font-size: 11.5px; color: var(--dim); background: rgba(29,35,42,.9);\n    border: 1px solid var(--line); border-radius: 999px; padding: 6px 14px;\n    display: flex; align-items: center; gap: 8px;\n  }\n  #link.stale { color: var(--warn); border-color: #6e5520; }\n\n  /* A 10in panel is 1024x600, and at that width the camera row and the link\n     pill both want the bottom of the screen. Lift the pill above the row --\n     measured, not guessed: the buttons occupy the bottom 56 px. */\n  @media (max-width: 1120px) {\n    #link { bottom: 66px; }\n    .cam { padding: 10px 12px; font-size: 12px; }\n    #state, #pallets { width: 216px; }\n    #safety { width: 200px; }\n  }\n\n  #boot {\n    position: fixed; inset: 0; z-index: 20; display: flex; align-items: center; justify-content: center;\n    background: var(--bg); color: var(--dim); font-size: 14px; flex-direction: column; gap: 12px;\n  }\n  #boot.err { color: #ff8d92; }\n  #boot code { font-family: var(--mono); font-size: 12px; color: var(--dim); max-width: 70ch; text-align: center; }\n</style>\n</head>\n<body>\n\n<div id=\"boot\">Loading cell model\u2026</div>\n\n<div id=\"faultbanner\"><span>&#9888;</span><span id=\"faulttext\"></span></div>\n\n<div class=\"hud card\" id=\"state\">\n  <div class=\"card-h\">Palletising cell <span id=\"statepill\" class=\"pill idle\" style=\"margin-left:auto\">\u2014</span></div>\n  <div class=\"card-b\">\n    <div class=\"row\"><span class=\"k\">Robot</span><span class=\"v\" id=\"v-robot\">\u2014</span></div>\n    <div class=\"row\"><span class=\"k\">Cases placed</span><span class=\"v acc big\" id=\"v-cases\">\u2014</span></div>\n    <div class=\"row\"><span class=\"k\">Rate</span><span class=\"v\" id=\"v-cpm\">\u2014</span></div>\n    <div class=\"row\"><span class=\"k\">Cycle</span><span class=\"v\" id=\"v-cycle\">\u2014</span></div>\n    <div class=\"row\"><span class=\"k\">Lift</span><span class=\"v\" id=\"v-lift\">\u2014</span></div>\n    <div class=\"row\"><span class=\"k\">Vacuum</span><span class=\"v\" id=\"v-vac\">\u2014</span></div>\n  </div>\n</div>\n\n<div class=\"hud card\" id=\"safety\">\n  <div class=\"card-h\">Safety &amp; interlocks</div>\n  <div class=\"card-b\" id=\"safety-b\">\n    <div class=\"sig\"><span class=\"led\" id=\"l-estop\"></span>Emergency stops</div>\n    <div class=\"sig\"><span class=\"led\" id=\"l-guards\"></span>Guards closed</div>\n    <div class=\"sig\"><span class=\"led\" id=\"l-air\"></span>Air supply</div>\n    <div class=\"sig\"><span class=\"led\" id=\"l-int\"></span>Interfaces</div>\n  </div>\n</div>\n\n<div class=\"hud card\" id=\"pallets\">\n  <div class=\"card-h\">Pallet build</div>\n  <div class=\"card-b\" id=\"pallets-b\"></div>\n</div>\n\n<div class=\"hud\" id=\"cams\"></div>\n<div id=\"link\"><span class=\"led\" id=\"l-link\"></span><span id=\"linktext\">connecting\u2026</span></div>\n\n<script src=\"lib?f=three\"></script>\n<script>\n(function () {\n  \"use strict\";\n\n  var boot = document.getElementById(\"boot\");\n  function die(msg, detail) {\n    boot.className = \"err\";\n    boot.innerHTML = \"<div>\" + msg + \"</div><code>\" + (detail || \"\") + \"</code>\";\n  }\n  if (!window.THREE) {\n    die(\"3D library did not load.\",\n        \"Expected it at &hellip;/system/webdev/Machine_HMI_Demo/lib?f=three \u2014 check the WebDev resource is deployed and scanned.\");\n    return;\n  }\n\n  // ----------------------------------------------------------------------\n  // Cell dimensions. Everything downstream derives from these, in metres,\n  // so changing a pallet size or a case size moves the pattern, the stack\n  // height and the robot's place positions together.\n  // ----------------------------------------------------------------------\n  var M = {\n    caseW: 0.30, caseD: 0.25, caseH: 0.22,   // 300 x 250 x 220 mm\n    palletW: 1.20, palletD: 1.00, palletH: 0.14,\n    perLayer: 12, layers: 5,\n    convY: 0.90, convLen: 3.30, convW: 0.62,\n    // Both stations and the conveyor pick point sit inside the arm's 2.5 m\n    // reach (upper 1.35 + forearm 1.15), so the model never shows the robot\n    // grasping at something it could not physically touch.\n    st1: { x: -1.45, z: -1.65 },\n    st2: { x: -1.45, z:  1.65 }\n  };\n  M.perPallet = M.perLayer * M.layers;\n\n  var COL = {\n    steel: 0x8d99a3, steelDark: 0x59636d, floor: 0x272e35,\n    grid: 0x39434c, fence: 0x6d7982, glass: 0x6cc4e8,\n    caseA: 0xc08a4a, caseB: 0xa9773d, pallet: 0x8a6a3a,\n    run: 0x46d07c, fault: 0xf0565e, warn: 0xeebf5e, info: 0x6cc4e8\n  };\n\n  // ----------------------------------------------------------------------\n  // Renderer, scene, camera\n  // ----------------------------------------------------------------------\n  var renderer = new THREE.WebGLRenderer({ antialias: true, powerPreference: \"high-performance\" });\n  renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));\n  renderer.setSize(window.innerWidth, window.innerHeight);\n  renderer.shadowMap.enabled = true;\n  renderer.shadowMap.type = THREE.PCFSoftShadowMap;\n  document.body.appendChild(renderer.domElement);\n\n  var scene = new THREE.Scene();\n  scene.background = new THREE.Color(0x171b20);\n  scene.fog = new THREE.Fog(0x171b20, 14, 30);\n\n  var camera = new THREE.PerspectiveCamera(42, window.innerWidth / window.innerHeight, 0.1, 200);\n\n  scene.add(new THREE.HemisphereLight(0xbcd2e2, 0x2c343c, 1.15));\n  scene.add(new THREE.AmbientLight(0xffffff, 0.28));\n  var key = new THREE.DirectionalLight(0xffffff, 1.35);\n  key.position.set(5.5, 8.5, 4.5);\n  key.castShadow = true;\n  key.shadow.mapSize.set(2048, 2048);\n  key.shadow.camera.near = 1; key.shadow.camera.far = 30;\n  key.shadow.camera.left = -9; key.shadow.camera.right = 9;\n  key.shadow.camera.top = 9;   key.shadow.camera.bottom = -9;\n  key.shadow.bias = -0.0012;\n  scene.add(key);\n  var fill = new THREE.DirectionalLight(0x8fb4d0, 0.35);\n  fill.position.set(-6, 4, -5);\n  scene.add(fill);\n\n  // ----------------------------------------------------------------------\n  // Helpers\n  // ----------------------------------------------------------------------\n  function mat(color, opts) {\n    opts = opts || {};\n    return new THREE.MeshStandardMaterial({\n      color: color,\n      metalness: opts.metalness !== undefined ? opts.metalness : 0.55,\n      roughness: opts.roughness !== undefined ? opts.roughness : 0.55,\n      transparent: !!opts.opacity,\n      opacity: opts.opacity !== undefined ? opts.opacity : 1\n    });\n  }\n  function box(w, h, d, material, x, y, z) {\n    var m = new THREE.Mesh(new THREE.BoxGeometry(w, h, d), material);\n    m.position.set(x || 0, y || 0, z || 0);\n    m.castShadow = true; m.receiveShadow = true;\n    return m;\n  }\n  function cyl(rt, rb, h, material, seg) {\n    var m = new THREE.Mesh(new THREE.CylinderGeometry(rt, rb, h, seg || 20), material);\n    m.castShadow = true; m.receiveShadow = true;\n    return m;\n  }\n\n  // ----------------------------------------------------------------------\n  // Floor and cell fence\n  // ----------------------------------------------------------------------\n  var floor = new THREE.Mesh(\n    new THREE.PlaneGeometry(30, 24),\n    new THREE.MeshStandardMaterial({ color: COL.floor, roughness: 0.95, metalness: 0.05 })\n  );\n  floor.rotation.x = -Math.PI / 2;\n  floor.receiveShadow = true;\n  scene.add(floor);\n\n  var grid = new THREE.GridHelper(30, 30, COL.grid, COL.grid);\n  grid.position.y = 0.004;\n  grid.material.opacity = 0.5; grid.material.transparent = true;\n  scene.add(grid);\n\n  // Safety fence: posts plus mesh panels. It is what makes the model read as\n  // a machine cell at a glance rather than as loose equipment on a floor.\n  var fence = new THREE.Group();\n  var fenceMat = mat(COL.fence, { roughness: 0.7 });\n  var panelMat = new THREE.MeshStandardMaterial({\n    color: 0x9fb6c8, transparent: true, opacity: 0.09,\n    roughness: 0.35, metalness: 0.1, side: THREE.DoubleSide,\n    depthWrite: false\n  });\n  function fenceRun(x1, z1, x2, z2) {\n    var dx = x2 - x1, dz = z2 - z1;\n    var len = Math.sqrt(dx * dx + dz * dz);\n    var g = new THREE.Group();\n    g.position.set(x1, 0, z1);\n    g.rotation.y = -Math.atan2(dz, dx);\n    var panel = box(len, 1.85, 0.03, panelMat, len / 2, 1.0, 0);\n    panel.castShadow = false;\n    g.add(panel);\n    var n = Math.max(2, Math.round(len / 1.5));\n    for (var i = 0; i <= n; i++) {\n      var p = cyl(0.035, 0.035, 2.0, fenceMat, 10);\n      p.position.set(len * i / n, 1.0, 0);\n      g.add(p);\n    }\n    var rail = box(len, 0.05, 0.05, fenceMat, len / 2, 1.95, 0);\n    g.add(rail);\n    return g;\n  }\n  // A tight cell, sized to the equipment inside it. The east side is left open\n  // where the infeed conveyor passes through, which is what the guarding on a\n  // real cell does.\n  var FX0 = -3.1, FX1 = 2.6, FZ0 = -2.75, FZ1 = 2.75;\n  fence.add(fenceRun(FX0, FZ0, FX1, FZ0));\n  fence.add(fenceRun(FX0, FZ1, FX0, FZ0));\n  fence.add(fenceRun(FX1, FZ0, FX1, FZ1));\n  fence.add(fenceRun(FX0, FZ1, 1.15, FZ1));\n  fence.add(fenceRun(2.15, FZ1, FX1, FZ1));\n  scene.add(fence);\n\n  // ----------------------------------------------------------------------\n  // Infeed conveyor, its cartons and its photo-eyes\n  // ----------------------------------------------------------------------\n  var infeed = new THREE.Group();\n  var conveyor = new THREE.Group();\n  infeed.add(conveyor);\n  var frameMat = mat(COL.steelDark, { roughness: 0.6 });\n  var rollerMat = mat(COL.steel, { metalness: 0.85, roughness: 0.35 });\n\n  var convX0 = 2.05, convX1 = convX0 + M.convLen;\n  var convMid = (convX0 + convX1) / 2;\n  conveyor.add(box(M.convLen, 0.10, 0.06, frameMat, convMid, M.convY - 0.06, -M.convW / 2));\n  conveyor.add(box(M.convLen, 0.10, 0.06, frameMat, convMid, M.convY - 0.06,  M.convW / 2));\n  var legXs = [convX0 + 0.35, convMid, convX1 - 0.35];\n  for (var i = 0; i < legXs.length; i++) {\n    for (var s = -1; s <= 1; s += 2) {\n      conveyor.add(box(0.07, M.convY - 0.12, 0.07, frameMat, legXs[i], (M.convY - 0.12) / 2, s * M.convW / 2));\n    }\n  }\n  var rollers = [];\n  for (var rx = convX0 + 0.09; rx < convX1; rx += 0.135) {\n    var r = cyl(0.045, 0.045, M.convW - 0.02, rollerMat, 12);\n    r.rotation.x = Math.PI / 2;\n    r.position.set(rx, M.convY, 0);\n    r.castShadow = false;\n    conveyor.add(r);\n    rollers.push(r);\n  }\n  infeed.rotation.y = -Math.PI / 2;\n  infeed.position.set(1.62, 0, -(convX0 + 0.35));\n  scene.add(infeed);\n\n  // Photo-eyes. Each is an emitter, a receiver and a beam whose colour is the\n  // live tag: a fitter can see WHICH eye is blocked and where to walk.\n  var peDefs = [\n    { key: \"infeed\",  x: convX1 - 0.35, label: \"PE Infeed\"  },\n    { key: \"len1\",    x: convX1 - 1.70, label: \"PE Length 1\" },\n    { key: \"len2\",    x: convX1 - 2.30, label: \"PE Length 2\" },\n    { key: \"carton\",  x: convX1 - 3.10, label: \"PE Carton\"  },\n    { key: \"inpos1\",  x: convX0 + 0.60, label: \"PE In-Pos 1\" },\n    { key: \"inpos2\",  x: convX0 + 0.25, label: \"PE In-Pos 2\" }\n  ];\n  var photoEyes = [];\n  peDefs.forEach(function (d) {\n    var g = new THREE.Group();\n    var post = box(0.05, 0.34, 0.05, frameMat, d.x, M.convY + 0.17, -M.convW / 2 - 0.10);\n    var post2 = box(0.05, 0.34, 0.05, frameMat, d.x, M.convY + 0.17, M.convW / 2 + 0.10);\n    g.add(post); g.add(post2);\n    var beamMat = new THREE.MeshBasicMaterial({ color: COL.run, transparent: true, opacity: 0.85 });\n    var beam = cyl(0.008, 0.008, M.convW + 0.20, beamMat, 6);\n    beam.rotation.x = Math.PI / 2;\n    beam.position.set(d.x, M.convY + 0.20, 0);\n    beam.castShadow = false;\n    g.add(beam);\n    infeed.add(g);\n    photoEyes.push({ key: d.key, label: d.label, beam: beam, mat: beamMat, x: d.x });\n  });\n\n  // Cartons riding the infeed.\n  var caseMatA = mat(COL.caseA, { metalness: 0.05, roughness: 0.85 });\n  var caseMatB = mat(COL.caseB, { metalness: 0.05, roughness: 0.85 });\n  function makeCase(alt) {\n    var g = new THREE.Group();\n    var body = box(M.caseW, M.caseH, M.caseD, alt ? caseMatB : caseMatA, 0, 0, 0);\n    g.add(body);\n    // A seam line so a stack of cases does not read as one solid block.\n    var seam = box(M.caseW + 0.004, 0.006, M.caseD * 0.02, mat(0x6b4a22, { metalness: 0, roughness: 1 }), 0, 0, M.caseD / 2);\n    seam.castShadow = false;\n    g.add(seam);\n    return g;\n  }\n  var infeedCases = [];\n  for (var c = 0; c < 6; c++) {\n    var cs = makeCase(c % 2 === 1);\n    cs.position.set(convX0 + 0.6 + c * 0.72, M.convY + M.caseH / 2 + 0.045, 0);\n    infeed.add(cs);\n    infeedCases.push(cs);\n  }\n\n  // ----------------------------------------------------------------------\n  // Pallet stations. Cases are pre-built and shown/hidden as the count moves,\n  // so a growing stack costs no allocation at run time.\n  // ----------------------------------------------------------------------\n  function layerLayout(layerIndex) {\n    // Alternating 4x3 / 3x4 grids on the same pallet: a real interlocked\n    // pattern, and visibly different layer to layer on the model.\n    var rot = layerIndex % 2 === 1;\n    var cw = rot ? M.caseD : M.caseW;\n    var cd = rot ? M.caseW : M.caseD;\n    var cols = rot ? 4 : 4;\n    var rows = 3;\n    var spanX = cols * cw, spanZ = rows * cd;\n    var out = [];\n    for (var r = 0; r < rows; r++) {\n      for (var q = 0; q < cols; q++) {\n        var inset = 0.94;\n        out.push({\n          x: (-spanX / 2 + cw * (q + 0.5)) * inset,\n          z: (-spanZ / 2 + cd * (r + 0.5)) * inset,\n          rot: rot ? Math.PI / 2 : 0\n        });\n      }\n    }\n    return out;\n  }\n\n  function makePalletStation(pos, name) {\n    var g = new THREE.Group();\n    g.position.set(pos.x, 0, pos.z);\n\n    var palletMat = mat(COL.pallet, { metalness: 0.02, roughness: 0.95 });\n    var deck = new THREE.Group();\n    for (var b = -1; b <= 1; b++) {\n      deck.add(box(M.palletW, 0.045, 0.10, palletMat, 0, M.palletH - 0.02, b * (M.palletD / 2 - 0.05)));\n    }\n    for (var k = 0; k < 5; k++) {\n      deck.add(box(0.09, 0.035, M.palletD, palletMat, -M.palletW / 2 + 0.045 + k * (M.palletW - 0.09) / 4, M.palletH + 0.02, 0));\n    }\n    for (var f = -1; f <= 1; f += 1) {\n      for (var h = -1; h <= 1; h += 2) {\n        deck.add(box(0.10, M.palletH - 0.04, 0.10, palletMat, h * (M.palletW / 2 - 0.05), (M.palletH - 0.04) / 2, f * (M.palletD / 2 - 0.05)));\n      }\n    }\n    g.add(deck);\n\n    // Station frame: a low guide rail, so an empty station still looks like\n    // a station rather than a bare pallet on the floor.\n    var railMat = mat(COL.steelDark, { roughness: 0.6 });\n    g.add(box(M.palletW + 0.30, 0.06, 0.06, railMat, 0, 0.10, -(M.palletD / 2 + 0.16)));\n    g.add(box(0.06, 0.06, M.palletD + 0.30, railMat, -(M.palletW / 2 + 0.16), 0.10, 0));\n\n    var cases = [];\n    for (var L = 0; L < M.layers; L++) {\n      var lay = layerLayout(L);\n      for (var n = 0; n < lay.length; n++) {\n        var cm = makeCase((L + n) % 2 === 1);\n        cm.position.set(lay[n].x, M.palletH + M.caseH * (L + 0.5) + 0.02, lay[n].z);\n        cm.rotation.y = lay[n].rot;\n        cm.visible = false;\n        g.add(cm);\n        cases.push(cm);\n      }\n    }\n    scene.add(g);\n    return { group: g, cases: cases, name: name, pos: pos };\n  }\n  var stations = [makePalletStation(M.st1, \"Station 1\"), makePalletStation(M.st2, \"Station 2\")];\n\n  // ----------------------------------------------------------------------\n  // The robot. Joint convention is the one frozen in the build contract:\n  //   j1 base about Y, lift raises the carriage, j2 shoulder about Z,\n  //   j3 elbow about Z, j4 wrist about Y.\n  // Each joint is its own Group so the tag value sets exactly one rotation.\n  // ----------------------------------------------------------------------\n  var robot = new THREE.Group();\n  var armMat = mat(0xe8a33d, { metalness: 0.35, roughness: 0.5 });   // machine yellow\n  var armDark = mat(0x30383f, { metalness: 0.6, roughness: 0.45 });\n\n  var pedestal = cyl(0.42, 0.50, 0.30, armDark, 28);\n  pedestal.position.y = 0.15;\n  robot.add(pedestal);\n\n  var baseYaw = new THREE.Group();           // j1\n  baseYaw.position.y = 0.30;\n  robot.add(baseYaw);\n\n  var columnMat = mat(0x4d5761, { metalness: 0.55, roughness: 0.5 });\n  var column = box(0.30, 2.35, 0.30, columnMat, 0, 1.175, 0);\n  baseYaw.add(column);\n  var colCapMat = mat(COL.steel, { metalness: 0.8, roughness: 0.3 });\n  for (var cg = -1; cg <= 1; cg += 2) {\n    var guide = cyl(0.022, 0.022, 2.25, colCapMat, 10);\n    guide.position.set(cg * 0.18, 1.175, 0.09);\n    baseYaw.add(guide);\n  }\n\n  var carriage = new THREE.Group();          // lift\n  baseYaw.add(carriage);\n  carriage.add(box(0.46, 0.34, 0.46, armMat, 0, 0, 0));\n\n  var shoulder = new THREE.Group();          // j2\n  shoulder.position.set(0.0, 0.0, 0.0);\n  carriage.add(shoulder);\n\n  var UPPER = 1.35, FORE = 1.15;\n  var upperArm = box(UPPER, 0.24, 0.26, armMat, UPPER / 2, 0, 0);\n  shoulder.add(upperArm);\n  var shoulderHub = cyl(0.15, 0.15, 0.30, armDark, 18);\n  shoulderHub.rotation.x = Math.PI / 2;\n  shoulder.add(shoulderHub);\n\n  var elbow = new THREE.Group();             // j3\n  elbow.position.set(UPPER, 0, 0);\n  shoulder.add(elbow);\n  var elbowHub = cyl(0.12, 0.12, 0.28, armDark, 18);\n  elbowHub.rotation.x = Math.PI / 2;\n  elbow.add(elbowHub);\n  var foreArm = box(FORE, 0.19, 0.21, armMat, FORE / 2, 0, 0);\n  elbow.add(foreArm);\n\n  var wrist = new THREE.Group();             // j4\n  wrist.position.set(FORE, 0, 0);\n  elbow.add(wrist);\n  wrist.add(cyl(0.10, 0.10, 0.16, armDark, 16));\n\n  // Vacuum gripper head: a plate of suction cups, which is what a case\n  // palletiser actually carries.\n  var gripper = new THREE.Group();\n  gripper.position.y = -0.14;\n  wrist.add(gripper);\n  var plateMat = mat(0x39424b, { metalness: 0.7, roughness: 0.4 });\n  gripper.add(box(M.caseW + 0.06, 0.07, M.caseD + 0.06, plateMat, 0, 0, 0));\n  var cupMat = mat(0x24292f, { metalness: 0.1, roughness: 0.9 });\n  var cups = [];\n  for (var cx = -1; cx <= 1; cx++) {\n    for (var cz = -1; cz <= 1; cz += 2) {\n      var cup = cyl(0.045, 0.032, 0.06, cupMat, 12);\n      cup.position.set(cx * (M.caseW / 3), -0.06, cz * (M.caseD / 4));\n      gripper.add(cup);\n      cups.push(cup);\n    }\n  }\n  // The case currently held. Parented to the gripper, so it simply follows.\n  var heldCase = makeCase(false);\n  heldCase.position.y = -0.09 - M.caseH / 2;\n  heldCase.visible = false;\n  gripper.add(heldCase);\n\n  robot.position.set(0, 0, 0);\n  scene.add(robot);\n\n  // ----------------------------------------------------------------------\n  // Fault highlighting. A faulted group pulses; the eye finds it immediately,\n  // which is the entire reason for showing a machine in 3D rather than a list.\n  // ----------------------------------------------------------------------\n  var highlights = [\n    { key: \"RobotAxisFault\", objs: [upperArm, foreArm, column], base: [] },\n    { key: \"VacuumLow\",      objs: [gripper],                   base: [] },\n    { key: \"ConveyorJam\",    objs: [infeed],                    base: [] }\n  ];\n  function collectMeshes(obj, out) {\n    // Materials are shared between meshes by design (every carton uses the same\n    // one), so writing .emissive on a highlighted mesh would tint every object\n    // that happens to share its material - which turned the pallet stacks red\n    // whenever the conveyor faulted. Give each highlightable mesh its own copy.\n    obj.traverse(function (o) {\n      if (o.isMesh && o.material && o.material.emissive) {\n        o.material = o.material.clone();\n        out.push(o);\n      }\n    });\n    return out;\n  }\n  highlights.forEach(function (h) {\n    var meshes = [];\n    h.objs.forEach(function (o) { collectMeshes(o, meshes); });\n    h.meshes = meshes;\n  });\n\n  // ----------------------------------------------------------------------\n  // Camera: presets plus touch-friendly orbit. OrbitControls is a separate\n  // three.js example file; a small implementation here keeps the page to one\n  // vendored dependency and behaves properly under a finger on a panel.\n  // ----------------------------------------------------------------------\n  var target = new THREE.Vector3(-0.20, 0.95, 0.15);\n  var sph = { r: 8.8, theta: -0.30, phi: 0.90 };\n  var want = { r: sph.r, theta: sph.theta, phi: sph.phi, target: target.clone() };\n\n  var PRESETS = [\n    { name: \"Overview\", r: 8.8,  theta: -0.30, phi: 0.90, t: [-0.20, 0.95, 0.15] },\n    { name: \"Robot\",    r: 4.6,  theta: -0.55, phi: 1.08, t: [0.0, 1.40, 0] },\n    { name: \"Pallet 1\", r: 3.3,  theta: -2.05, phi: 1.14, t: [M.st1.x, 0.80, M.st1.z] },\n    { name: \"Pallet 2\", r: 3.3,  theta: -2.60, phi: 1.14, t: [M.st2.x, 0.80, M.st2.z] },\n    { name: \"Infeed\",   r: 4.4,  theta: -0.10, phi: 1.14, t: [1.62, 1.15, 0.85] },\n    { name: \"Top\",      r: 7.6,  theta: -1.30, phi: 0.28, t: [-0.45, 0.60, 0] }\n  ];\n  var camsEl = document.getElementById(\"cams\");\n  var camButtons = [];\n  PRESETS.forEach(function (p, idx) {\n    var b = document.createElement(\"button\");\n    b.className = \"cam\" + (idx === 0 ? \" active\" : \"\");\n    b.type = \"button\";\n    b.textContent = p.name;\n    b.addEventListener(\"click\", function () {\n      want.r = p.r; want.theta = p.theta; want.phi = p.phi;\n      want.target.set(p.t[0], p.t[1], p.t[2]);\n      camButtons.forEach(function (o) { o.classList.remove(\"active\"); });\n      b.classList.add(\"active\");\n    });\n    camsEl.appendChild(b);\n    camButtons.push(b);\n  });\n  function clearPreset() { camButtons.forEach(function (o) { o.classList.remove(\"active\"); }); }\n\n  var drag = null;\n  var el = renderer.domElement;\n  el.addEventListener(\"pointerdown\", function (e) {\n    el.setPointerCapture(e.pointerId);\n    drag = { x: e.clientX, y: e.clientY, pan: e.button === 2 || e.shiftKey };\n  });\n  el.addEventListener(\"pointermove\", function (e) {\n    if (!drag) return;\n    var dx = e.clientX - drag.x, dy = e.clientY - drag.y;\n    drag.x = e.clientX; drag.y = e.clientY;\n    if (drag.pan) {\n      var right = new THREE.Vector3().setFromMatrixColumn(camera.matrix, 0);\n      var up = new THREE.Vector3().setFromMatrixColumn(camera.matrix, 1);\n      var k = want.r * 0.0016;\n      want.target.addScaledVector(right, -dx * k).addScaledVector(up, dy * k);\n    } else {\n      want.theta -= dx * 0.006;\n      want.phi = Math.max(0.12, Math.min(1.52, want.phi - dy * 0.006));\n    }\n    clearPreset();\n  });\n  function endDrag() { drag = null; }\n  el.addEventListener(\"pointerup\", endDrag);\n  el.addEventListener(\"pointercancel\", endDrag);\n  el.addEventListener(\"contextmenu\", function (e) { e.preventDefault(); });\n  el.addEventListener(\"wheel\", function (e) {\n    e.preventDefault();\n    want.r = Math.max(2.2, Math.min(24, want.r * (1 + Math.sign(e.deltaY) * 0.12)));\n    clearPreset();\n  }, { passive: false });\n\n  // Pinch to zoom, because this runs on a touch panel.\n  var pinch = null;\n  el.addEventListener(\"touchstart\", function (e) {\n    if (e.touches.length === 2) {\n      pinch = Math.hypot(e.touches[0].clientX - e.touches[1].clientX,\n                         e.touches[0].clientY - e.touches[1].clientY);\n    }\n  }, { passive: true });\n  el.addEventListener(\"touchmove\", function (e) {\n    if (e.touches.length === 2 && pinch) {\n      var d = Math.hypot(e.touches[0].clientX - e.touches[1].clientX,\n                         e.touches[0].clientY - e.touches[1].clientY);\n      want.r = Math.max(2.2, Math.min(24, want.r * (pinch / d)));\n      pinch = d;\n      clearPreset();\n    }\n  }, { passive: true });\n  el.addEventListener(\"touchend\", function () { pinch = null; }, { passive: true });\n\n  // ----------------------------------------------------------------------\n  // Live data. The page polls the same WebDev endpoint the HMI screens use.\n  // If it cannot reach it, the cell keeps moving on a local cycle and SAYS SO\n  // rather than freezing \u2014 a dead 3D view in front of a customer is worse\n  // than an honest one.\n  // ----------------------------------------------------------------------\n  var live = null, lastGood = 0, linkOK = false, usingFallback = false;\n  var sim = { t: 0 };\n\n  function poll() {\n    fetch(\"admin?cmd=state\", { cache: \"no-store\" })\n      .then(function (r) { return r.ok ? r.json() : Promise.reject(r.status); })\n      .then(function (j) {\n        if (!j || j.ok === false) throw new Error(\"bad payload\");\n        live = j; lastGood = performance.now(); linkOK = true; usingFallback = false;\n      })\n      .catch(function () { linkOK = false; });\n  }\n  poll();\n  setInterval(poll, 250);\n\n  // Local fallback motion, so the model is never a still image.\n  function fallbackState(dt) {\n    sim.t += dt;\n    var cyc = (sim.t % 6) / 6;\n    var placing = cyc > 0.5;\n    var e = placing ? (cyc - 0.5) * 2 : cyc * 2;\n    var ease = 0.5 - 0.5 * Math.cos(e * Math.PI);\n    var n = Math.floor(sim.t / 1.5) % (M.perPallet + 6);\n    return {\n      line: { running: true, mode: \"Auto\", cpm: 14.2, cycle: 6.0,\n              cases: Math.floor(sim.t / 1.5), target: 0 },\n      robot: {\n        state: placing ? \"Placing\" : \"Picking\",\n        j1: placing ? (10 - 150 * ease) : (-140 + 150 * ease),\n        j2: 18 + 26 * Math.sin(ease * Math.PI),\n        j3: -58 - 22 * Math.sin(ease * Math.PI),\n        j4: 0, lift: 260 + 520 * Math.sin(ease * Math.PI),\n        grip: placing ? ease < 0.86 : ease > 0.9,\n        vac: placing ? -62 : 0, cycles: 0, fault: false, faultText: \"\"\n      },\n      pallets: [\n        { present: true, cases: Math.min(n, M.perPallet), layer: Math.floor(Math.min(n, M.perPallet) / M.perLayer), complete: n >= M.perPallet, pattern: \"4x3 interlock\" },\n        { present: true, cases: Math.max(0, Math.min(M.perPallet, n - 14)), layer: 0, complete: false, pattern: \"4x3 interlock\" }\n      ],\n      conv: { c1: true, c2: true, c3: true,\n              pe: { infeed: true, carton: false, len1: true, len2: false, inpos1: true, inpos2: false, clear: true },\n              gate1: false, gate2: true, clamp: true, barcode: \"\u2014\", scanOK: true },\n      safety: { estop: true, guards: true, air: true, interfaces: true },\n      faults: {}, zones: []\n    };\n  }\n\n  // ----------------------------------------------------------------------\n  // Applying state to the model\n  // ----------------------------------------------------------------------\n  var shown = { j1: 0, j2: 0, j3: 0, j4: 0, lift: 0 };\n  var D2R = Math.PI / 180;\n\n  function damp(cur, goal, dt, rate) {\n    return cur + (goal - cur) * (1 - Math.exp(-rate * dt));\n  }\n\n  function applyState(s, dt) {\n    var r = s.robot || {};\n    shown.j1 = damp(shown.j1, r.j1 || 0, dt, 7);\n    shown.j2 = damp(shown.j2, r.j2 || 0, dt, 7);\n    shown.j3 = damp(shown.j3, r.j3 || 0, dt, 7);\n    shown.j4 = damp(shown.j4, r.j4 || 0, dt, 7);\n    shown.lift = damp(shown.lift, r.lift || 0, dt, 7);\n\n    baseYaw.rotation.y = shown.j1 * D2R;\n    carriage.position.y = 0.34 + (shown.lift / 1000);\n    shoulder.rotation.z = shown.j2 * D2R;\n    elbow.rotation.z = shown.j3 * D2R;\n    wrist.rotation.y = shown.j4 * D2R;\n\n    heldCase.visible = !!r.grip;\n    var cupTarget = r.grip ? 0.045 : 0.06;\n    for (var i = 0; i < cups.length; i++) {\n      cups[i].scale.y = damp(cups[i].scale.y, r.grip ? 0.7 : 1.0, dt, 10);\n    }\n\n    // pallets\n    var pl = s.pallets || [];\n    for (var p = 0; p < stations.length; p++) {\n      var st = stations[p];\n      var d = pl[p] || { cases: 0 };\n      var n = Math.max(0, Math.min(M.perPallet, d.cases | 0));\n      for (var c = 0; c < st.cases.length; c++) {\n        st.cases[c].visible = c < n;\n      }\n      st.group.visible = d.present !== false;\n    }\n\n    // photo-eyes: blocked reads red, clear reads green\n    var pe = (s.conv && s.conv.pe) || {};\n    for (var q = 0; q < photoEyes.length; q++) {\n      var blocked = !!pe[photoEyes[q].key];\n      photoEyes[q].mat.color.setHex(blocked ? COL.fault : COL.run);\n      photoEyes[q].mat.opacity = blocked ? 0.95 : 0.55;\n    }\n\n    // conveyor cartons move only while the conveyor runs\n    var running = !(s.conv && s.conv.c1 === false);\n    if (running) {\n      for (var k = 0; k < infeedCases.length; k++) {\n        infeedCases[k].position.x -= dt * 0.55;\n        if (infeedCases[k].position.x < convX0 + 0.35) {\n          infeedCases[k].position.x = convX1 - 0.2;\n        }\n      }\n      for (var rr = 0; rr < rollers.length; rr++) rollers[rr].rotation.y += dt * 6;\n    }\n\n    // fault pulse\n    var faults = s.faults || {};\n    var pulse = 0.5 + 0.5 * Math.sin(performance.now() / 190);\n    highlights.forEach(function (h) {\n      var on = !!faults[h.key];\n      h.meshes.forEach(function (m) {\n        m.material.emissive.setHex(on ? COL.fault : 0x000000);\n        m.material.emissiveIntensity = on ? 0.25 + 0.55 * pulse : 0;\n      });\n    });\n  }\n\n  // ----------------------------------------------------------------------\n  // HUD\n  // ----------------------------------------------------------------------\n  var els = {\n    pill: document.getElementById(\"statepill\"),\n    robot: document.getElementById(\"v-robot\"),\n    cases: document.getElementById(\"v-cases\"),\n    cpm: document.getElementById(\"v-cpm\"),\n    cycle: document.getElementById(\"v-cycle\"),\n    lift: document.getElementById(\"v-lift\"),\n    vac: document.getElementById(\"v-vac\"),\n    estop: document.getElementById(\"l-estop\"),\n    guards: document.getElementById(\"l-guards\"),\n    air: document.getElementById(\"l-air\"),\n    int: document.getElementById(\"l-int\"),\n    pallets: document.getElementById(\"pallets-b\"),\n    banner: document.getElementById(\"faultbanner\"),\n    bannerText: document.getElementById(\"faulttext\"),\n    link: document.getElementById(\"link\"),\n    linkLed: document.getElementById(\"l-link\"),\n    linkText: document.getElementById(\"linktext\")\n  };\n\n  var FAULT_LABELS = {\n    WrapperFilmFeed: \"Wrapper \u2014 film feed torque high\",\n    ConveyorJam: \"Infeed conveyor \u2014 carton jam at the measuring station\",\n    VacuumLow: \"Gripper \u2014 vacuum below threshold\",\n    GuardOpen: \"Guard circuit open \u2014 motion inhibited\",\n    RobotAxisFault: \"Robot \u2014 axis fault, reset required\"\n  };\n\n  function setLed(node, ok, warn) {\n    node.className = \"led \" + (ok ? \"on\" : (warn ? \"wrn\" : \"bad\"));\n  }\n\n  var palletDom = null;\n  function buildPalletDom() {\n    els.pallets.innerHTML = \"\";\n    palletDom = stations.map(function (st, i) {\n      var wrap = document.createElement(\"div\");\n      wrap.className = \"pal\";\n      wrap.innerHTML =\n        '<div class=\"pal-h\"><b>' + st.name + '</b><span class=\"pat\"></span><span class=\"n\"></span></div>' +\n        '<div class=\"bar\"><i style=\"width:0%\"></i></div>' +\n        '<div class=\"layers\"></div>';\n      var lay = wrap.querySelector(\".layers\");\n      for (var L = 0; L < M.layers; L++) lay.appendChild(document.createElement(\"span\"));\n      els.pallets.appendChild(wrap);\n      return {\n        n: wrap.querySelector(\".n\"),\n        bar: wrap.querySelector(\".bar i\"),\n        pat: wrap.querySelector(\".pat\"),\n        layers: lay.querySelectorAll(\"span\")\n      };\n    });\n  }\n  buildPalletDom();\n\n  function updateHUD(s) {\n    var r = s.robot || {}, ln = s.line || {}, sf = s.safety || {}, fl = s.faults || {};\n\n    var anyFault = Object.keys(fl).some(function (k) { return fl[k]; }) || r.fault;\n    var pillCls = anyFault ? \"flt\" : (ln.running ? \"run\" : \"idle\");\n    var pillTxt = anyFault ? \"Fault\" : (ln.running ? \"Running\" : \"Stopped\");\n    els.pill.className = \"pill \" + pillCls;\n    els.pill.textContent = pillTxt;\n\n    els.robot.textContent = r.state || \"\u2014\";\n    els.cases.textContent = (ln.cases != null ? ln.cases : 0) +\n      (ln.target ? \" / \" + ln.target : \"\");\n    els.cpm.textContent = (ln.cpm != null ? ln.cpm.toFixed(1) : \"\u2014\") + \" /min\";\n    els.cycle.textContent = (ln.cycle != null ? ln.cycle.toFixed(2) : \"\u2014\") + \" s\";\n    els.lift.textContent = (r.lift != null ? r.lift.toFixed(0) : \"\u2014\") + \" mm\";\n    els.vac.textContent = (r.vac != null ? r.vac.toFixed(1) : \"\u2014\") + \" kPa\";\n\n    setLed(els.estop, sf.estop !== false);\n    setLed(els.guards, sf.guards !== false);\n    setLed(els.air, sf.air !== false);\n    setLed(els.int, sf.interfaces !== false);\n\n    var pl = s.pallets || [];\n    palletDom.forEach(function (d, i) {\n      var p = pl[i] || { cases: 0, layer: 0 };\n      var n = Math.max(0, Math.min(M.perPallet, p.cases | 0));\n      d.n.textContent = n + \" / \" + M.perPallet;\n      d.bar.style.width = (100 * n / M.perPallet).toFixed(1) + \"%\";\n      d.pat.textContent = p.pattern || \"\";\n      d.pat.style.cssText = \"color:#8b98a3;font-size:11px\";\n      for (var L = 0; L < d.layers.length; L++) {\n        var full = (L + 1) * M.perLayer <= n;\n        var part = !full && L * M.perLayer < n;\n        d.layers[L].className = full ? \"done\" : (part ? \"part\" : \"\");\n      }\n    });\n\n    var msgs = Object.keys(fl).filter(function (k) { return fl[k]; })\n                    .map(function (k) { return FAULT_LABELS[k] || k; });\n    if (r.fault && r.faultText) msgs.unshift(r.faultText);\n    if (msgs.length) {\n      els.banner.classList.add(\"show\");\n      els.bannerText.textContent = msgs[0] + (msgs.length > 1 ? \"  (+\" + (msgs.length - 1) + \" more)\" : \"\");\n    } else {\n      els.banner.classList.remove(\"show\");\n    }\n\n    if (linkOK) {\n      els.link.className = \"\";\n      els.linkLed.className = \"led on\";\n      els.linkText.textContent = \"live from [MachineDemo] tags\";\n    } else {\n      els.link.className = \"stale\";\n      els.linkLed.className = \"led wrn\";\n      els.linkText.textContent = \"no tag data \u2014 showing local motion\";\n    }\n  }\n\n  // ----------------------------------------------------------------------\n  // Anchored labels: HTML positioned at projected 3D points. Cheaper and far\n  // sharper than texture labels, and they stay readable at any zoom.\n  // ----------------------------------------------------------------------\n  var labelDefs = [\n    { id: \"lbl-grip\", anchor: function () {\n        var v = new THREE.Vector3(); gripper.getWorldPosition(v); v.y -= 0.35; return v; },\n      text: function (s) {\n        var r = s.robot || {};\n        return r.grip ? \"case held &middot; <b>\" + (r.vac || 0).toFixed(0) + \" kPa</b>\"\n                      : \"gripper open\";\n      },\n      bad: function (s) { return (s.faults || {}).VacuumLow; } },\n    { id: \"lbl-st1\", anchor: function () { return new THREE.Vector3(M.st1.x, 1.55, M.st1.z); },\n      text: function (s) { var p = (s.pallets || [])[0] || {};\n        return \"Station 1 &middot; <b>\" + (p.cases | 0) + \"</b>/\" + M.perPallet + \" &middot; layer <b>\" + ((p.layer | 0) + (p.cases ? 1 : 0)) + \"</b>\"; } },\n    { id: \"lbl-st2\", anchor: function () { return new THREE.Vector3(M.st2.x, 1.55, M.st2.z); },\n      text: function (s) { var p = (s.pallets || [])[1] || {};\n        return \"Station 2 &middot; <b>\" + (p.cases | 0) + \"</b>/\" + M.perPallet + \" &middot; layer <b>\" + ((p.layer | 0) + (p.cases ? 1 : 0)) + \"</b>\"; } },\n    { id: \"lbl-conv\", anchor: function () {\n        return infeed.localToWorld(new THREE.Vector3(convX0 + 1.0, M.convY + 0.75, 0)); },\n      text: function (s) { var c = s.conv || {};\n        return \"Infeed &middot; <b>\" + (c.barcode || \"\u2014\") + \"</b>\"; },\n      bad: function (s) { return (s.faults || {}).ConveyorJam; } }\n  ];\n  labelDefs.forEach(function (d) {\n    var n = document.createElement(\"div\");\n    n.className = \"tag3d\"; n.id = d.id;\n    document.body.appendChild(n);\n    d.node = n;\n  });\n\n  var proj = new THREE.Vector3();\n  function updateLabels(s) {\n    for (var i = 0; i < labelDefs.length; i++) {\n      var d = labelDefs[i];\n      proj.copy(d.anchor()).project(camera);\n      var behind = proj.z > 1;\n      if (behind) { d.node.style.display = \"none\"; continue; }\n      d.node.style.display = \"block\";\n      d.node.style.left = ((proj.x * 0.5 + 0.5) * window.innerWidth) + \"px\";\n      d.node.style.top = ((-proj.y * 0.5 + 0.5) * window.innerHeight) + \"px\";\n      d.node.innerHTML = d.text(s);\n      d.node.className = \"tag3d\" + (d.bad && d.bad(s) ? \" bad\" : \"\");\n    }\n  }\n\n  // ----------------------------------------------------------------------\n  // Main loop\n  // ----------------------------------------------------------------------\n  var last = performance.now();\n  var hudAccum = 0;\n  boot.style.display = \"none\";\n\n  function frame(now) {\n    var dt = Math.min(0.1, (now - last) / 1000);\n    last = now;\n\n    // camera easing\n    sph.r = damp(sph.r, want.r, dt, 6);\n    sph.theta = damp(sph.theta, want.theta, dt, 6);\n    sph.phi = damp(sph.phi, want.phi, dt, 6);\n    target.lerp(want.target, 1 - Math.exp(-6 * dt));\n    camera.position.set(\n      target.x + sph.r * Math.sin(sph.phi) * Math.cos(sph.theta),\n      target.y + sph.r * Math.cos(sph.phi),\n      target.z + sph.r * Math.sin(sph.phi) * Math.sin(sph.theta)\n    );\n    camera.lookAt(target);\n\n    var s = (linkOK && live) ? live : fallbackState(dt);\n    applyState(s, dt);\n    updateLabels(s);\n\n    hudAccum += dt;\n    if (hudAccum > 0.12) { updateHUD(s); hudAccum = 0; }\n\n    renderer.render(scene, camera);\n    requestAnimationFrame(frame);\n  }\n  requestAnimationFrame(frame);\n\n  window.addEventListener(\"resize\", function () {\n    camera.aspect = window.innerWidth / window.innerHeight;\n    camera.updateProjectionMatrix();\n    renderer.setSize(window.innerWidth, window.innerHeight);\n  });\n})();\n</script>\n</body>\n</html>\n"
