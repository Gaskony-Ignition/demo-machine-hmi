{
  "resource-type": "text-resource",
  "content-type": "text/html",
  "text": "<!doctype html>\n<html lang=\"en-AU\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, user-scalable=no\">\n<title>CAD model viewer</title>\n<style>\n  :root { color-scheme: dark; --bg:#171b20; --panel:rgba(29,35,42,.92);\n          --line:#2c343d; --ink:#dde4e9; --dim:#8b98a3; --info:#6cc4e8;\n          --mono:\"DejaVu Sans Mono\",\"Liberation Mono\",Consolas,monospace; }\n  * { box-sizing:border-box; }\n  html,body { height:100%; margin:0; overflow:hidden; background:var(--bg); }\n  body { font-family:\"Noto Sans\",\"Segoe UI\",system-ui,sans-serif; color:var(--ink); }\n  canvas { display:block; touch-action:none; cursor:grab; }\n  canvas.dragging { cursor:grabbing; }\n  #boot { position:absolute; inset:0; display:flex; flex-direction:column;\n          align-items:center; justify-content:center; gap:12px; color:var(--dim); }\n  #boot.err { color:#ff8d92; }\n  #boot code { font-family:var(--mono); font-size:12px; max-width:70ch;\n               text-align:center; color:var(--dim); }\n  .card { position:absolute; background:var(--panel); border:1px solid var(--line);\n          border-radius:6px; padding:10px 13px; font-size:12px; }\n  #info { top:14px; left:14px; }\n  #info h1 { margin:0 0 7px; font-size:12px; letter-spacing:1.2px;\n             text-transform:uppercase; color:var(--dim); font-weight:700; }\n  #info .row { display:flex; justify-content:space-between; gap:22px;\n               font-family:var(--mono); padding:1px 0; }\n  #info .row b { font-weight:400; color:var(--dim); }\n  #help { bottom:14px; left:14px; color:var(--dim); line-height:1.7; }\n  #help kbd { font-family:var(--mono); color:var(--ink); background:#222a32;\n              border:1px solid var(--line); border-radius:3px; padding:1px 5px;\n              font-size:11px; }\n  #picked { bottom:14px; right:14px; color:var(--dim); }\n  #picked em { color:var(--info); font-style:normal; font-family:var(--mono); }\n  #buttons { position:absolute; top:14px; right:14px; display:flex; gap:8px; }\n  button { font:inherit; font-size:12px; color:var(--ink); background:var(--panel);\n           border:1px solid var(--line); border-radius:6px; padding:8px 13px;\n           cursor:pointer; }\n  button:hover { border-color:var(--info); color:var(--info); }\n</style>\n</head>\n<body>\n<div id=\"boot\">Loading model…</div>\n\n<div class=\"card\" id=\"info\" hidden>\n  <h1>Model</h1>\n  <div class=\"row\"><b>parts</b><span id=\"mParts\">—</span></div>\n  <div class=\"row\"><b>triangles</b><span id=\"mTris\">—</span></div>\n  <div class=\"row\"><b>size</b><span id=\"mSize\">—</span></div>\n</div>\n\n<div id=\"buttons\">\n  <button id=\"bFit\">Fit</button>\n  <button id=\"bWire\">Wireframe</button>\n  <button id=\"bSpin\">Turntable</button>\n</div>\n\n<div class=\"card\" id=\"help\" hidden>\n  <kbd>drag</kbd> rotate &nbsp; <kbd>wheel</kbd> zoom &nbsp;\n  <kbd>right-drag</kbd> pan &nbsp; <kbd>click</kbd> identify a part\n</div>\n<div class=\"card\" id=\"picked\" hidden>no part selected</div>\n\n<script src=\"lib?f=three\"></script>\n<script>\n(function () {\n  \"use strict\";\n  var boot = document.getElementById(\"boot\");\n  function die(msg, detail) {\n    boot.className = \"err\";\n    boot.innerHTML = \"<div>\" + msg + \"</div><code>\" + (detail || \"\") + \"</code>\";\n  }\n  if (!window.THREE) { die(\"three.js did not load.\", \"lib?f=three\"); return; }\n  window.addEventListener(\"error\", function (e) {\n    if (boot.style.display === \"none\") { return; }\n    die(\"The model could not be shown.\", (e && e.message) || \"unknown\");\n  });\n  try {\n    var c0 = document.createElement(\"canvas\");\n    if (!(c0.getContext(\"webgl\") || c0.getContext(\"experimental-webgl\"))) {\n      throw new Error(\"no WebGL context\");\n    }\n  } catch (err) {\n    die(\"This browser has no WebGL, so the model cannot draw.\",\n        \"Turn on hardware acceleration - chrome://flags/#ignore-gpu-blocklist.\");\n    return;\n  }\n\n  // Binary STL -> BufferGeometry. Written out because three r150+ removed the\n  // non-module examples/js loaders, and this page must stay dependency free:\n  // it has to render on a panel with no internet.\n  function parseBinarySTL(buf) {\n    var dv = new DataView(buf), n = dv.getUint32(80, true);\n    if (84 + n * 50 !== buf.byteLength) {\n      throw new Error(\"not a binary STL, or truncated\");\n    }\n    var pos = new Float32Array(n * 9);\n    for (var i = 0; i < n; i++) {\n      var o = 84 + i * 50, p = i * 9;\n      for (var v = 0; v < 3; v++) {\n        var q = o + 12 + v * 12, k = p + v * 3;\n        pos[k]     = dv.getFloat32(q, true);\n        pos[k + 1] = dv.getFloat32(q + 4, true);\n        pos[k + 2] = dv.getFloat32(q + 8, true);\n      }\n    }\n    var g = new THREE.BufferGeometry();\n    g.setAttribute(\"position\", new THREE.BufferAttribute(pos, 3));\n    // The file's own face normals are ignored on purpose: exporters write them\n    // inconsistently and an inverted set renders as a solid black silhouette,\n    // which reads as a lighting bug and is not one.\n    g.computeVertexNormals();\n    return { geometry: g, triangles: n };\n  }\n\n  // Whatever STL files are in the cad resource folder ARE the model. No list\n  // to maintain here: adding a part is dropping a file in and rescanning.\n  //\n  // Each file is drawn at its own coordinates. Parts exported from one CAD\n  // assembly share that assembly's origin, so they land already assembled;\n  // parts modelled individually each sit at their own origin and will stack up\n  // on top of each other, which is a CAD export choice, not a viewer bug.\n  var PARTS = [];\n\n  fetch(\"cad?f=list\").then(function (r) { return r.json(); }).then(function (j) {\n    if (!j.ok) { throw new Error(j.error || \"could not list the cad folder\"); }\n    PARTS = j.parts || [];\n    if (!PARTS.length) {\n      throw new Error(\"no .stl files in the project's webdev cad folder\");\n    }\n    return Promise.all(PARTS.map(function (name) {\n      return fetch(\"cad?f=\" + encodeURIComponent(name)).then(function (r) {\n        if (!r.ok) { throw new Error(name + \" -> HTTP \" + r.status); }\n        return r.arrayBuffer();\n      }).then(parseBinarySTL);\n    }));\n  }).then(build).catch(function (e) {\n    die(\"Could not load the model.\", e.message || String(e));\n  });\n\n  function build(parts) {\n    var renderer = new THREE.WebGLRenderer({ antialias: true });\n    renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));\n    renderer.setSize(window.innerWidth, window.innerHeight);\n    document.body.appendChild(renderer.domElement);\n    var cv = renderer.domElement;\n\n    var scene = new THREE.Scene();\n    scene.background = new THREE.Color(0x171b20);\n    var camera = new THREE.PerspectiveCamera(\n      45, window.innerWidth / window.innerHeight, 0.01, 200);\n\n    scene.add(new THREE.HemisphereLight(0xbfd4e6, 0x20262c, 2.0));\n    var key = new THREE.DirectionalLight(0xffffff, 2.0);\n    key.position.set(2, 3, 2); scene.add(key);\n    var fill = new THREE.DirectionalLight(0xffffff, 0.7);\n    fill.position.set(-2, 1, -2); scene.add(fill);\n    scene.add(new THREE.GridHelper(2, 20, 0x2c343d, 0x232a31));\n\n    var mat = new THREE.MeshStandardMaterial(\n      { color: 0xd0d5da, metalness: 0.0, roughness: 0.55,\n        side: THREE.DoubleSide });\n    var hot = new THREE.MeshStandardMaterial(\n      { color: 0x6cc4e8, metalness: 0.0, roughness: 0.5,\n        side: THREE.DoubleSide });\n\n    // CAD is Z-up; three.js is Y-up. Rotate only the MODEL, never the scene -\n    // scene.rotation turns the lights with it and lights the model from below.\n    var root = new THREE.Group();\n    root.rotation.x = -Math.PI / 2;\n    scene.add(root);\n\n    var tris = 0, meshes = [];\n    parts.forEach(function (p, i) {\n      var mesh = new THREE.Mesh(p.geometry, mat);\n      mesh.name = PARTS[i];\n      root.add(mesh);\n      meshes.push(mesh);\n      tris += p.triangles;\n    });\n\n    var box = new THREE.Box3().setFromObject(root);\n    var size = new THREE.Vector3(); box.getSize(size);\n    var target = new THREE.Vector3(); box.getCenter(target);\n\n    document.getElementById(\"mParts\").textContent = PARTS.length;\n    document.getElementById(\"mTris\").textContent = tris.toLocaleString();\n    document.getElementById(\"mSize\").textContent =\n      (size.x * 1000).toFixed(0) + \" x \" + (size.y * 1000).toFixed(0) +\n      \" x \" + (size.z * 1000).toFixed(0) + \" mm\";\n    [\"info\", \"help\", \"picked\"].forEach(function (id) {\n      document.getElementById(id).hidden = false;\n    });\n    boot.style.display = \"none\";\n\n    // ------------------------------------------------------------------\n    // Orbit / pan / zoom. r160's UMD build ships no OrbitControls (it is an\n    // ES module now), so this is the whole thing: spherical camera around a\n    // target, right-drag moves the target in the camera's own plane.\n    // ------------------------------------------------------------------\n    var sph = { r: 0, theta: Math.PI * 0.25, phi: Math.PI * 0.35 };\n    var spin = false;\n\n    function fit() {\n      box.setFromObject(root);\n      box.getSize(size); box.getCenter(target);\n      // Frame against BOTH axes: a long, flat model (most machine assemblies)\n      // is limited by the horizontal field, and sizing on the vertical one\n      // alone leaves it a third of the frame with dead space all round.\n      var vFov = camera.fov * Math.PI / 180;\n      var hFov = 2 * Math.atan(Math.tan(vFov / 2) * camera.aspect);\n      var horiz = Math.max(size.x, size.z);\n      sph.r = Math.max(horiz / (2 * Math.tan(hFov / 2)),\n                       size.y / (2 * Math.tan(vFov / 2))) * 1.25;\n      sph.theta = Math.PI * 0.25; sph.phi = Math.PI * 0.35;\n    }\n    fit();\n\n    function apply() {\n      sph.phi = Math.max(0.05, Math.min(Math.PI - 0.05, sph.phi));\n      camera.position.set(\n        target.x + sph.r * Math.sin(sph.phi) * Math.sin(sph.theta),\n        target.y + sph.r * Math.cos(sph.phi),\n        target.z + sph.r * Math.sin(sph.phi) * Math.cos(sph.theta));\n      camera.lookAt(target);\n    }\n\n    var drag = null;\n    cv.addEventListener(\"pointerdown\", function (e) {\n      // Capture is a convenience, not a requirement: it throws for a pointer\n      // the browser is not tracking, and an exception here would leave the\n      // whole viewer unresponsive to that gesture.\n      try { cv.setPointerCapture(e.pointerId); } catch (ignored) {}\n      drag = { x: e.clientX, y: e.clientY, btn: e.button, moved: 0 };\n      cv.classList.add(\"dragging\");\n    });\n    cv.addEventListener(\"pointermove\", function (e) {\n      if (!drag) { return; }\n      var dx = e.clientX - drag.x, dy = e.clientY - drag.y;\n      drag.x = e.clientX; drag.y = e.clientY;\n      drag.moved += Math.abs(dx) + Math.abs(dy);\n      if (drag.btn === 2) {\n        var k = sph.r * 0.0015;\n        var right = new THREE.Vector3(), up = new THREE.Vector3();\n        camera.matrixWorld.extractBasis(right, up, new THREE.Vector3());\n        target.addScaledVector(right, -dx * k);\n        target.addScaledVector(up, dy * k);\n      } else {\n        sph.theta -= dx * 0.006;\n        sph.phi   -= dy * 0.006;\n      }\n      spin = false;\n    });\n    function endDrag(e) {\n      if (drag && drag.btn === 0 && drag.moved < 5) { pick(e); }\n      drag = null; cv.classList.remove(\"dragging\");\n    }\n    cv.addEventListener(\"pointerup\", endDrag);\n    cv.addEventListener(\"pointercancel\", function () { drag = null; });\n    cv.addEventListener(\"contextmenu\", function (e) { e.preventDefault(); });\n    cv.addEventListener(\"wheel\", function (e) {\n      e.preventDefault();\n      sph.r *= (e.deltaY > 0) ? 1.12 : 0.89;\n      sph.r = Math.max(0.05, Math.min(50, sph.r));\n    }, { passive: false });\n\n    // pinch to zoom, for a panel\n    var pinch = null;\n    cv.addEventListener(\"touchmove\", function (e) {\n      if (e.touches.length !== 2) { pinch = null; return; }\n      var d = Math.hypot(e.touches[0].clientX - e.touches[1].clientX,\n                         e.touches[0].clientY - e.touches[1].clientY);\n      if (pinch) { sph.r *= pinch / d; }\n      pinch = d;\n    }, { passive: true });\n    cv.addEventListener(\"touchend\", function () { pinch = null; });\n\n    var ray = new THREE.Raycaster(), ndc = new THREE.Vector2(), lit = null;\n    function pick(e) {\n      var r = cv.getBoundingClientRect();\n      ndc.x = ((e.clientX - r.left) / r.width) * 2 - 1;\n      ndc.y = -((e.clientY - r.top) / r.height) * 2 + 1;\n      ray.setFromCamera(ndc, camera);\n      var hit = ray.intersectObjects(meshes, false)[0];\n      if (lit) { lit.material = mat; lit = null; }\n      var out = document.getElementById(\"picked\");\n      if (hit) {\n        lit = hit.object; lit.material = hot;\n        out.innerHTML = \"part <em>\" + hit.object.name + \"</em> &middot; \" +\n                        hit.distance.toFixed(2) + \" m from camera\";\n      } else {\n        out.textContent = \"no part selected\";\n      }\n    }\n\n    document.getElementById(\"bFit\").onclick = function () { fit(); };\n    document.getElementById(\"bWire\").onclick = function () {\n      mat.wireframe = !mat.wireframe; hot.wireframe = mat.wireframe;\n    };\n    document.getElementById(\"bSpin\").onclick = function () { spin = !spin; };\n\n    var last = performance.now();\n    function frame(now) {\n      var dt = Math.min(0.1, (now - last) / 1000); last = now;\n      if (spin) { sph.theta += dt * 0.5; }\n      apply();\n      renderer.render(scene, camera);\n      requestAnimationFrame(frame);\n    }\n    requestAnimationFrame(frame);\n\n    window.addEventListener(\"resize\", function () {\n      camera.aspect = window.innerWidth / window.innerHeight;\n      camera.updateProjectionMatrix();\n      renderer.setSize(window.innerWidth, window.innerHeight);\n    });\n  }\n})();\n</script></body></html>\n"
}