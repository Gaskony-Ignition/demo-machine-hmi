{
  "resource-type": "text-resource",
  "content-type": "text/html",
  "text": "<!doctype html>\n<html lang=\"en-AU\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, user-scalable=no\">\n<title>CAD model viewer</title>\n<style>\n  :root { color-scheme: dark; --bg:#171b20; --panel:rgba(29,35,42,.94);\n          --line:#2c343d; --ink:#dde4e9; --dim:#8b98a3; --info:#6cc4e8;\n          --fault:#f0565e; --warn:#eebf5e;\n          --mono:\"DejaVu Sans Mono\",\"Liberation Mono\",Consolas,monospace; }\n  * { box-sizing:border-box; }\n  html,body { height:100%; margin:0; overflow:hidden; background:var(--bg); }\n  body { font-family:\"Noto Sans\",\"Segoe UI\",system-ui,sans-serif; color:var(--ink); }\n  canvas { display:block; touch-action:none; cursor:grab; }\n  canvas.dragging { cursor:grabbing; }\n  #boot { position:absolute; inset:0; display:flex; flex-direction:column;\n          align-items:center; justify-content:center; gap:12px; color:var(--dim); }\n  #boot.err { color:#ff8d92; }\n  #boot code { font-family:var(--mono); font-size:12px; max-width:70ch;\n               text-align:center; color:var(--dim); }\n  .card { position:absolute; background:var(--panel); border:1px solid var(--line);\n          border-radius:6px; padding:10px 13px; font-size:12px; }\n  #info { top:14px; left:14px; }\n  #info h1 { margin:0 0 7px; font-size:12px; letter-spacing:1.2px;\n             text-transform:uppercase; color:var(--dim); font-weight:700; }\n  #info .row { display:flex; justify-content:space-between; gap:22px;\n               font-family:var(--mono); padding:1px 0; }\n  #info .row b { font-weight:400; color:var(--dim); }\n  #mName { max-width:24ch; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }\n  #help { bottom:14px; left:14px; color:var(--dim); line-height:1.7; }\n  #help kbd { font-family:var(--mono); color:var(--ink); background:#222a32;\n              border:1px solid var(--line); border-radius:3px; padding:1px 5px;\n              font-size:11px; }\n  #picked { bottom:58px; left:14px; color:var(--dim); }\n  #picked em { color:var(--info); font-style:normal; font-family:var(--mono); }\n  #buttons { position:absolute; top:14px; right:14px; display:flex; gap:8px; }\n  button { font:inherit; font-size:12px; color:var(--ink); background:var(--panel);\n           border:1px solid var(--line); border-radius:6px; padding:8px 13px;\n           cursor:pointer; }\n  button:hover { border-color:var(--info); color:var(--info); }\n  button:focus-visible { outline:2px solid var(--info); outline-offset:1px; }\n\n  /* Alarm panel: right column, between the buttons and the bottom edge. Rows\n     that do not fit are counted, never scrolled - no inner scroll bars. */\n  #alarms { top:58px; right:14px; width:min(480px, calc(100% - 28px)); padding:0; display:flex;\n            flex-direction:column; max-height:calc(100% - 72px); }\n  #alarms header { display:flex; align-items:center; gap:8px; padding:9px 12px;\n                   border-bottom:1px solid var(--line); }\n  #alarms h2 { margin:0; font-size:12px; letter-spacing:1.2px; text-transform:uppercase;\n               color:var(--dim); font-weight:700; flex:1; }\n  #aCount { font-family:var(--mono); color:var(--dim); }\n  #aCount.hot { color:var(--fault); font-weight:700; }\n  #aFilter { display:none; padding:3px 8px; font-size:11px; }\n  #aFilter.on { display:inline-block; }\n  #aRows { overflow:hidden; }\n  .arow { display:grid; grid-template-columns:84px 1fr 56px 60px 58px; gap:8px;\n          width:100%; text-align:left; border:0; border-left:3px solid transparent;\n          border-bottom:1px solid var(--line); border-radius:0; padding:6px 10px 6px 9px;\n          background:transparent; align-items:center; }\n  .arow:hover { background:rgba(108,196,232,.08); color:var(--ink); }\n  .arow.sel { background:rgba(108,196,232,.16); border-left-color:var(--info); }\n  .arow span { overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }\n  .arow .part { font-family:var(--mono); color:var(--info); }\n  .arow .pri { font-size:11px; }\n  .arow .st { font-size:11px; color:var(--dim); }\n  .arow .st.un { color:var(--fault); font-weight:700; }\n  .arow .tm { font-family:var(--mono); color:var(--dim); text-align:right; }\n  .p-Critical { color:var(--fault); font-weight:700; }\n  .p-High { color:var(--fault); }\n  .p-Medium { color:var(--warn); }\n  .ahead { cursor:default; color:var(--dim); font-size:11px; text-transform:uppercase;\n           letter-spacing:.8px; }\n  .ahead:hover { background:transparent; color:var(--dim); }\n  #aNote { padding:10px 12px; color:var(--dim); line-height:1.5; }\n  #aNote code { font-family:var(--mono); color:var(--ink); }\n</style>\n</head>\n<body>\n<div id=\"boot\">Loading model\u2026</div>\n\n<div class=\"card\" id=\"info\" hidden>\n  <h1>Model</h1>\n  <div class=\"row\"><b>name</b><span id=\"mName\">\u2014</span></div>\n  <div class=\"row\"><b>parts</b><span id=\"mParts\">\u2014</span></div>\n  <div class=\"row\"><b>triangles</b><span id=\"mTris\">\u2014</span></div>\n  <div class=\"row\"><b>size</b><span id=\"mSize\">\u2014</span></div>\n</div>\n\n<div id=\"buttons\">\n  <button id=\"bFit\">Fit</button>\n  <button id=\"bWire\">Wireframe</button>\n  <button id=\"bSpin\">Turntable</button>\n</div>\n\n<div class=\"card\" id=\"alarms\" hidden>\n  <header>\n    <h2>Part alarms</h2>\n    <button id=\"aFilter\" title=\"Show alarms on every part\"></button>\n    <span id=\"aCount\">0</span>\n  </header>\n  <div id=\"aRows\"></div>\n  <div id=\"aNote\"></div>\n</div>\n\n<div class=\"card\" id=\"help\" hidden>\n  <kbd>drag</kbd> rotate &nbsp; <kbd>wheel</kbd> zoom &nbsp;\n  <kbd>right-drag</kbd> pan &nbsp; <kbd>click</kbd> a part to filter its alarms\n</div>\n<div class=\"card\" id=\"picked\" hidden>no part selected</div>\n\n<script src=\"lib?f=three\"></script>\n<script>\n(function () {\n  \"use strict\";\n  var boot = document.getElementById(\"boot\");\n  function esc(s) {\n    return String(s == null ? \"\" : s).replace(/[&<>\"]/g, function (c) {\n      return { \"&\": \"&amp;\", \"<\": \"&lt;\", \">\": \"&gt;\", '\"': \"&quot;\" }[c];\n    });\n  }\n  function die(msg, detail) {\n    boot.className = \"err\";\n    boot.style.display = \"\";\n    boot.innerHTML = \"<div>\" + esc(msg) + \"</div><code>\" + esc(detail || \"\") + \"</code>\";\n  }\n  if (!window.THREE) { die(\"three.js did not load.\", \"lib?f=three\"); return; }\n  window.addEventListener(\"error\", function (e) {\n    if (boot.style.display === \"none\") { return; }\n    die(\"The model could not be shown.\", (e && e.message) || \"unknown\");\n  });\n  try {\n    var c0 = document.createElement(\"canvas\");\n    if (!(c0.getContext(\"webgl\") || c0.getContext(\"experimental-webgl\"))) {\n      throw new Error(\"no WebGL context\");\n    }\n  } catch (err) {\n    die(\"This browser has no WebGL, so the model cannot draw.\",\n        \"Turn on hardware acceleration - chrome://flags/#ignore-gpu-blocklist.\");\n    return;\n  }\n\n  // ?model=<name> is an uploaded model (gateway data dir); none is the\n  // built-in one in the project's cad resource.\n  var MODEL = new URLSearchParams(window.location.search).get(\"model\") || \"\";\n  var Q = MODEL ? \"&model=\" + encodeURIComponent(MODEL) : \"\";\n  var COL_FAULT = 0xf0565e, COL_SEL = 0x6cc4e8, COL_BASE = 0xd0d5da;\n\n  // Binary STL -> BufferGeometry. Written out because three r150+ removed the\n  // non-module examples/js loaders, and this page must stay dependency free:\n  // it has to render on a panel with no internet.\n  function parseBinarySTL(buf) {\n    var dv = new DataView(buf), n = dv.getUint32(80, true);\n    if (84 + n * 50 !== buf.byteLength) {\n      throw new Error(\"not a binary STL, or truncated\");\n    }\n    var pos = new Float32Array(n * 9);\n    for (var i = 0; i < n; i++) {\n      var o = 84 + i * 50, p = i * 9;\n      for (var v = 0; v < 3; v++) {\n        var q = o + 12 + v * 12, k = p + v * 3;\n        pos[k]     = dv.getFloat32(q, true);\n        pos[k + 1] = dv.getFloat32(q + 4, true);\n        pos[k + 2] = dv.getFloat32(q + 8, true);\n      }\n    }\n    var g = new THREE.BufferGeometry();\n    g.setAttribute(\"position\", new THREE.BufferAttribute(pos, 3));\n    // The file's own face normals are ignored on purpose: exporters write them\n    // inconsistently and an inverted set renders as a solid black silhouette,\n    // which reads as a lighting bug and is not one.\n    g.computeVertexNormals();\n    return { geometry: g, triangles: n };\n  }\n\n  function fetchBytes(url) {\n    return fetch(url).then(function (r) {\n      if (!r.ok) { throw new Error(url + \" -> HTTP \" + r.status); }\n      return r.arrayBuffer();\n    });\n  }\n\n  // -> [{name, geometries:[{geometry, triangles, color}]}], one per pickable part\n  function loadSTL(names) {\n    return Promise.all(names.map(function (name) {\n      return fetchBytes(\"cad?f=\" + encodeURIComponent(name) + Q)\n        .then(parseBinarySTL).then(function (p) {\n          return { name: name, geometries: [p] };\n        });\n    }));\n  }\n\n  function loadScript(src) {\n    return new Promise(function (ok, fail) {\n      var s = document.createElement(\"script\");\n      s.src = src; s.onload = ok;\n      s.onerror = function () { fail(new Error(src + \" did not load\")); };\n      document.head.appendChild(s);\n    });\n  }\n\n  // STEP keeps product names. occt-import-js hangs a sub-assembly's leaf\n  // solids on the sub-assembly node as meshes, each carrying its own product\n  // name, so the part name comes from the MESH and only falls back to the\n  // node. Solids of one product (six identical bolts) share a name and light\n  // up together, which is what a part NUMBER means.\n  function loadSTEP(stem) {\n    boot.textContent = \"Reading STEP\u2026 (the reader is 7.6 MB, fetched once)\";\n    return Promise.all([\n      loadScript(\"lib?f=occt\").then(function () {\n        return window.occtimportjs({\n          // the .wasm sits behind the lib route, not beside the script\n          locateFile: function () { return \"lib?f=occt-wasm\"; }\n        });\n      }),\n      fetchBytes(\"cad?f=\" + encodeURIComponent(stem) + Q)\n    ]).then(function (r) {\n      var res = r[0].ReadStepFile(new Uint8Array(r[1]), { linearUnit: \"meter\" });\n      if (!res || !res.success) { throw new Error(\"the STEP file could not be read\"); }\n      var parts = [], byName = {};\n      (function walk(node) {\n        if (node.meshes && node.meshes.length) {\n          node.meshes.forEach(function (mi) {\n            var m = res.meshes[mi], g = new THREE.BufferGeometry();\n            var name = (m.name || \"\").trim() || (node.name || \"\").trim() ||\n                       (\"part \" + (parts.length + 1));\n            var part = byName[name];\n            if (!part) { part = byName[name] = { name: name, geometries: [] }; parts.push(part); }\n            g.setAttribute(\"position\", new THREE.Float32BufferAttribute(m.attributes.position.array, 3));\n            if (m.attributes.normal) {\n              g.setAttribute(\"normal\", new THREE.Float32BufferAttribute(m.attributes.normal.array, 3));\n            }\n            g.setIndex(new THREE.Uint32BufferAttribute(m.index.array, 1));\n            if (!m.attributes.normal) { g.computeVertexNormals(); }\n            part.geometries.push({ geometry: g, triangles: m.index.array.length / 3,\n              color: m.color ? new THREE.Color(m.color[0], m.color[1], m.color[2]).getHex() : null });\n          });\n        }\n        (node.children || []).forEach(walk);\n      })(res.root);\n      if (!parts.length) { throw new Error(\"the STEP file has no solid geometry\"); }\n      // The gateway never parses STEP, so it learns the part names from here,\n      // for the simulate-alarm part list. Names only; a failure costs nothing.\n      fetch(\"cad?f=parts\" + Q, { method: \"POST\", headers: { \"Content-Type\": \"application/json\" },\n        body: JSON.stringify(parts.map(function (p) { return p.name; })) }).catch(function () {});\n      return parts;\n    });\n  }\n\n  var KIND = \"stl\";\n  fetch(\"cad?f=list\" + Q).then(function (r) { return r.json(); }).then(function (j) {\n    if (!j.ok) {\n      throw new Error(MODEL ? \"model '\" + MODEL + \"': \" + (j.error || \"not found\")\n                            : (j.error || \"could not list the cad folder\"));\n    }\n    KIND = j.kind || \"stl\";\n    if (!(j.parts || []).length) {\n      throw new Error(\"no .stl files in the project's webdev cad folder\");\n    }\n    return KIND === \"step\" ? loadSTEP(j.parts[0]) : loadSTL(j.parts);\n  }).then(build).catch(function (e) {\n    die(\"Could not load the model.\", e.message || String(e));\n  });\n\n  function build(parts) {\n    var renderer = new THREE.WebGLRenderer({ antialias: true });\n    renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));\n    renderer.setSize(window.innerWidth, window.innerHeight);\n    document.body.appendChild(renderer.domElement);\n    var cv = renderer.domElement;\n\n    var scene = new THREE.Scene();\n    scene.background = new THREE.Color(0x171b20);\n    // The only handle anything outside this page gets. The 3D cell page\n    // exposes __cellScene for the same reason: without it a headless gate can\n    // only screenshot the canvas, and a canvas that renders nothing looks\n    // exactly like a canvas that renders a dark model.\n    window.__cadScene = scene;\n    var camera = new THREE.PerspectiveCamera(45, 1, 0.01, 200);\n\n    scene.add(new THREE.HemisphereLight(0xbfd4e6, 0x20262c, 2.0));\n    var key = new THREE.DirectionalLight(0xffffff, 2.0);\n    key.position.set(2, 3, 2); scene.add(key);\n    var fill = new THREE.DirectionalLight(0xffffff, 0.7);\n    fill.position.set(-2, 1, -2); scene.add(fill);\n\n    // CAD is Z-up; three.js is Y-up. Rotate only the MODEL, never the scene -\n    // scene.rotation turns the lights with it and lights the model from below.\n    var root = new THREE.Group();\n    root.rotation.x = -Math.PI / 2;\n    scene.add(root);\n\n    // Every mesh has its own material: alarm tint and selection are per part,\n    // and a shared material would tint every part that uses it.\n    var tris = 0, meshes = [], PART = {};\n    parts.forEach(function (p) {\n      var entry = { name: p.name, meshes: [], alarm: null };\n      p.geometries.forEach(function (g) {\n        var base = g.color != null ? g.color : COL_BASE;\n        var mesh = new THREE.Mesh(g.geometry, new THREE.MeshStandardMaterial(\n          { color: base, metalness: 0.0, roughness: 0.55, side: THREE.DoubleSide }));\n        mesh.name = p.name;\n        mesh.userData.base = base;\n        root.add(mesh);\n        meshes.push(mesh);\n        entry.meshes.push(mesh);\n        tris += g.triangles;\n      });\n      PART[p.name.toLowerCase()] = entry;\n    });\n\n    // STL carries no units. A model under 20 units across is read as metres\n    // (the UR5 sample is), anything bigger as millimetres - the usual export.\n    var box = new THREE.Box3().setFromObject(root);\n    var size = new THREE.Vector3(); box.getSize(size);\n    var mm = KIND === \"stl\" && Math.max(size.x, size.y, size.z) > 20;\n    if (mm) { root.scale.setScalar(0.001); box.setFromObject(root); }\n    // Stand the whole model on the grid: centred in plan, lowest point on the\n    // floor. One move of the root, so the parts keep their places relative to\n    // each other. CAD origins are wherever the designer left them, which put\n    // a zip of three wrist parts well away from a grid drawn at the origin.\n    var c0 = new THREE.Vector3(); box.getCenter(c0);\n    root.position.set(-c0.x, -box.min.y, -c0.z);\n    box.setFromObject(root); box.getSize(size);\n    var target = new THREE.Vector3(); box.getCenter(target);\n    var span = Math.max(size.x, size.y, size.z) || 1;\n    // the grid is sized to the footprint, with a margin round it\n    var foot = Math.max(size.x, size.z) * 1.6 || span;\n    var grid = new THREE.GridHelper(foot, 16, 0x2c343d, 0x232a31);\n    scene.add(grid);\n\n    document.getElementById(\"mName\").textContent =\n      (MODEL || \"built-in\") + \" \u00b7 \" + KIND.toUpperCase();\n    document.getElementById(\"mName\").title = MODEL || \"built-in\";\n    document.getElementById(\"mParts\").textContent = parts.length;\n    document.getElementById(\"mTris\").textContent = tris.toLocaleString();\n    document.getElementById(\"mSize\").textContent =\n      (size.x * 1000).toFixed(0) + \" x \" + (size.y * 1000).toFixed(0) +\n      \" x \" + (size.z * 1000).toFixed(0) + \" mm\";\n    [\"info\", \"help\", \"picked\", \"alarms\"].forEach(function (id) {\n      document.getElementById(id).hidden = false;\n    });\n    boot.style.display = \"none\";\n\n    // The alarm panel covers the right of the canvas, so the camera frames the\n    // model in the area left of it: a wider virtual frame, rendered offset.\n    var panelEl = document.getElementById(\"alarms\");\n    var freeAspect = 1;\n    function layoutCamera() {\n      var W = window.innerWidth, H = window.innerHeight;\n      var pw = panelEl.offsetWidth + 28;\n      if (W - pw < 360) { pw = 0; }\n      freeAspect = (W - pw) / H;\n      camera.aspect = (W + pw) / H;\n      if (pw) { camera.setViewOffset(W + pw, H, pw, 0, W, H); }\n      else { camera.clearViewOffset(); }\n      camera.updateProjectionMatrix();\n    }\n    layoutCamera();\n\n    // ------------------------------------------------------------------\n    // Orbit / pan / zoom. r160's UMD build ships no OrbitControls (it is an\n    // ES module now), so this is the whole thing: spherical camera around a\n    // target, right-drag moves the target in the camera's own plane.\n    // ------------------------------------------------------------------\n    var sph = { r: 0, theta: Math.PI * 0.25, phi: Math.PI * 0.35 };\n    var spin = false;\n\n    // margin 1.15 clears the overlay cards; a single part gets more, so the\n    // operator still sees where on the machine it is.\n    function frameBox(b, keepAngle, margin) {\n      b.getCenter(target);\n      if (!keepAngle) { sph.theta = Math.PI * 0.25; sph.phi = Math.PI * 0.35; }\n      // Frame against BOTH axes, measured in the CAMERA's frame rather than\n      // the world's. max(size.x, size.z) is the extent along the world axes,\n      // and a long model seen from 45 degrees is wider than either of them -\n      // which is how a 930 mm arm ran off the side of a frame sized to hold\n      // 930 mm. Projecting the eight corners of the bounding box onto the\n      // camera's own right/up axes gives the extent that actually has to fit.\n      var dir = new THREE.Vector3(\n        Math.sin(sph.phi) * Math.sin(sph.theta),\n        Math.cos(sph.phi),\n        Math.sin(sph.phi) * Math.cos(sph.theta));\n      var right = new THREE.Vector3()\n        .crossVectors(dir, new THREE.Vector3(0, 1, 0)).normalize();\n      var camUp = new THREE.Vector3().crossVectors(right, dir).normalize();\n      var vFov = camera.fov * Math.PI / 180;\n      var tanV = Math.tan(vFov / 2), tanH = tanV * freeAspect;\n      // Solve per corner rather than framing the whole extent at the centre\n      // distance. The camera is a perspective one, so a corner nearer the lens\n      // than the centre projects LARGER than its half-extent suggests: the\n      // distance that has to hold corner i is |w|/tan + (how far it leans\n      // towards the camera), and the answer is the largest of the eight.\n      var need = 0, corner = new THREE.Vector3();\n      for (var i = 0; i < 8; i++) {\n        corner.set(i & 1 ? b.max.x : b.min.x,\n                   i & 2 ? b.max.y : b.min.y,\n                   i & 4 ? b.max.z : b.min.z).sub(target);\n        var towards = corner.dot(dir);\n        need = Math.max(need,\n                        Math.abs(corner.dot(right)) / tanH + towards,\n                        Math.abs(corner.dot(camUp)) / tanV + towards);\n      }\n      sph.r = need * (margin || 1.15);\n    }\n    function fit() { box.setFromObject(root); frameBox(box, false); }\n    fit();\n\n    function apply() {\n      sph.phi = Math.max(0.05, Math.min(Math.PI - 0.05, sph.phi));\n      // Clip planes follow the zoom, so a 20 mm part and a 20 m line both draw.\n      camera.near = sph.r / 1000; camera.far = sph.r * 100 + span * 10;\n      camera.updateProjectionMatrix();\n      camera.position.set(\n        target.x + sph.r * Math.sin(sph.phi) * Math.sin(sph.theta),\n        target.y + sph.r * Math.cos(sph.phi),\n        target.z + sph.r * Math.sin(sph.phi) * Math.cos(sph.theta));\n      camera.lookAt(target);\n    }\n\n    var drag = null;\n    cv.addEventListener(\"pointerdown\", function (e) {\n      // Capture is a convenience, not a requirement: it throws for a pointer\n      // the browser is not tracking, and an exception here would leave the\n      // whole viewer unresponsive to that gesture.\n      try { cv.setPointerCapture(e.pointerId); } catch (ignored) {}\n      drag = { x: e.clientX, y: e.clientY, btn: e.button, moved: 0 };\n      cv.classList.add(\"dragging\");\n    });\n    cv.addEventListener(\"pointermove\", function (e) {\n      if (!drag) { return; }\n      var dx = e.clientX - drag.x, dy = e.clientY - drag.y;\n      drag.x = e.clientX; drag.y = e.clientY;\n      drag.moved += Math.abs(dx) + Math.abs(dy);\n      if (drag.btn === 2) {\n        var k = sph.r * 0.0015;\n        var right = new THREE.Vector3(), up = new THREE.Vector3();\n        camera.matrixWorld.extractBasis(right, up, new THREE.Vector3());\n        target.addScaledVector(right, -dx * k);\n        target.addScaledVector(up, dy * k);\n      } else {\n        sph.theta -= dx * 0.006;\n        sph.phi   -= dy * 0.006;\n      }\n      spin = false;\n    });\n    function endDrag(e) {\n      if (drag && drag.btn === 0 && drag.moved < 5) { pick(e); }\n      drag = null; cv.classList.remove(\"dragging\");\n    }\n    cv.addEventListener(\"pointerup\", endDrag);\n    cv.addEventListener(\"pointercancel\", function () { drag = null; });\n    cv.addEventListener(\"contextmenu\", function (e) { e.preventDefault(); });\n    cv.addEventListener(\"wheel\", function (e) {\n      e.preventDefault();\n      sph.r *= (e.deltaY > 0) ? 1.12 : 0.89;\n      sph.r = Math.max(span * 0.01, Math.min(span * 50, sph.r));\n    }, { passive: false });\n\n    // pinch to zoom, for a panel\n    var pinch = null;\n    cv.addEventListener(\"touchmove\", function (e) {\n      if (e.touches.length !== 2) { pinch = null; return; }\n      var d = Math.hypot(e.touches[0].clientX - e.touches[1].clientX,\n                         e.touches[0].clientY - e.touches[1].clientY);\n      if (pinch) { sph.r *= pinch / d; }\n      pinch = d;\n    }, { passive: true });\n    cv.addEventListener(\"touchend\", function () { pinch = null; });\n\n    // ------------------------------------------------------------------\n    // Selection. A part picked in the model filters the alarm panel; a row\n    // picked in the panel selects and frames its part.\n    // ------------------------------------------------------------------\n    var selected = null, filter = null, selRow = null;\n    var pickedEl = document.getElementById(\"picked\");\n    // The outline, not the colour, marks the selection: a selected part in\n    // alarm is already tinted red, and blue over red reads as neither.\n    var selBox = new THREE.Box3Helper(new THREE.Box3(), COL_SEL);\n    selBox.visible = false;\n    scene.add(selBox);\n    function select(name, frame) {\n      var p = name ? PART[name.toLowerCase()] : null;\n      selected = p ? p.name : null;\n      selBox.visible = !!p;\n      if (p) {\n        selBox.box.makeEmpty();\n        p.meshes.forEach(function (m) { selBox.box.expandByObject(m); });\n        var n = p.meshes.length;\n        pickedEl.innerHTML = \"part <em>\" + esc(p.name) + \"</em>\" +\n          (n > 1 && KIND === \"step\" ? \" &middot; \" + n + \" solids\" : \"\") +\n          (p.alarm ? \" &middot; <span style='color:var(--fault)'>in alarm</span>\" : \"\");\n        if (frame) {\n          frameBox(selBox.box.clone(), true, 2.2);\n        }\n      } else {\n        pickedEl.textContent = \"no part selected\";\n      }\n    }\n\n    var ray = new THREE.Raycaster(), ndc = new THREE.Vector2();\n    function pick(e) {\n      var r = cv.getBoundingClientRect();\n      ndc.x = ((e.clientX - r.left) / r.width) * 2 - 1;\n      ndc.y = -((e.clientY - r.top) / r.height) * 2 + 1;\n      ray.setFromCamera(ndc, camera);\n      var hit = ray.intersectObjects(meshes, false)[0];\n      select(hit ? hit.object.name : null, false);\n      filter = selected;\n      selRow = null;\n      renderAlarms();\n    }\n\n    document.getElementById(\"bFit\").onclick = function () { fit(); };\n    document.getElementById(\"bWire\").onclick = function () {\n      var w = !meshes[0].material.wireframe;\n      meshes.forEach(function (m) { m.material.wireframe = w; });\n    };\n    document.getElementById(\"bSpin\").onclick = function () { spin = !spin; };\n\n    // ------------------------------------------------------------------\n    // Alarms linked by part number. cad?f=alarms lists every standing alarm\n    // on the demo's provider that carries the CadPart associated data; the\n    // ones whose part is in THIS model are shown and tinted. Matching ignores\n    // case - a part number typed into an alarm is not worth failing on.\n    // ------------------------------------------------------------------\n    var rowsEl = document.getElementById(\"aRows\"), noteEl = document.getElementById(\"aNote\");\n    var countEl = document.getElementById(\"aCount\"), filterBtn = document.getElementById(\"aFilter\");\n    var ALARMS = [], KEY = \"CadPart\", alarmErr = null;\n    filterBtn.onclick = function () { filter = null; selRow = null; select(null); renderAlarms(); };\n\n    function poll() {\n      fetch(\"cad?f=alarms\", { cache: \"no-store\" }).then(function (r) { return r.json(); })\n        .then(function (j) {\n          alarmErr = j.ok ? null : (j.error || \"alarm query failed\");\n          KEY = j.key || KEY;\n          ALARMS = (j.alarms || []).filter(function (a) {\n            return a.active && PART[String(a.part).toLowerCase()];\n          });\n        }).catch(function (e) { alarmErr = e.message || String(e); })\n        .then(function () {\n          Object.keys(PART).forEach(function (k) { PART[k].alarm = null; });\n          ALARMS.forEach(function (a) {\n            var p = PART[String(a.part).toLowerCase()];\n            // an unacknowledged alarm outranks an acknowledged one on the same part\n            if (!p.alarm || (p.alarm.acked && !a.acked)) { p.alarm = a; }\n          });\n          renderAlarms();\n          setTimeout(poll, 2000);\n        });\n    }\n\n    // The panel's clock, not the gateway's: the same time zone as the rest of\n    // the browser the operator is looking at.\n    function hms(ts) {\n      if (!ts) { return \"\"; }\n      var d = new Date(ts), z = function (n) { return (n < 10 ? \"0\" : \"\") + n; };\n      return z(d.getHours()) + \":\" + z(d.getMinutes()) + \":\" + z(d.getSeconds());\n    }\n\n    function renderAlarms() {\n      var shown = ALARMS.filter(function (a) {\n        return !filter || String(a.part).toLowerCase() === filter.toLowerCase();\n      });\n      countEl.textContent = ALARMS.length;\n      countEl.className = ALARMS.some(function (a) { return !a.acked; }) ? \"hot\" : \"\";\n      filterBtn.className = filter ? \"on\" : \"\";\n      filterBtn.textContent = filter ? \"part: \" + filter + \"  \u2715\" : \"\";\n      var html = shown.length ? \"<div class='arow ahead'><span>Part</span><span>Alarm</span>\" +\n        \"<span>Priority</span><span>State</span><span>Time</span></div>\" : \"\";\n      shown.forEach(function (a, i) {\n        var id = a.part + \"|\" + a.name;\n        html += \"<button class='arow\" + (id === selRow ? \" sel\" : \"\") + \"' data-i='\" + i +\n          \"' title='\" + esc(a.label || a.name) + \"'>\" +\n          \"<span class='part'>\" + esc(a.part) + \"</span>\" +\n          \"<span>\" + esc(a.name) + \"</span>\" +\n          \"<span class='pri p-\" + esc(a.priority) + \"'>\" + esc(a.priority) + \"</span>\" +\n          \"<span class='st\" + (a.acked ? \"\" : \" un\") + \"'>\" + (a.acked ? \"Acked\" : \"Unacked\") + \"</span>\" +\n          \"<span class='tm'>\" + esc(hms(a.ts) || a.time) + \"</span></button>\";\n      });\n      rowsEl.innerHTML = html;\n      Array.prototype.forEach.call(rowsEl.querySelectorAll(\"button.arow\"), function (b) {\n        b.onclick = function () {\n          var a = shown[+b.getAttribute(\"data-i\")];\n          selRow = a.part + \"|\" + a.name;\n          select(a.part, true);\n          renderAlarms();\n        };\n      });\n      var note = \"\";\n      if (alarmErr) { note = \"Alarm query failed: \" + esc(alarmErr); }\n      else if (!shown.length) {\n        note = filter ? \"No active alarms on <code>\" + esc(filter) + \"</code>.\"\n          : \"No active alarms on this model's parts. An alarm links to a part through \" +\n            \"its <code>\" + esc(KEY) + \"</code> associated data.\";\n      }\n      noteEl.innerHTML = note;\n      noteEl.style.display = note ? \"\" : \"none\";\n      // Rows that do not fit are counted, not scrolled. The note line is put\n      // in first so the rows are measured against the room that is left.\n      var rows = rowsEl.querySelectorAll(\"button.arow\"), hidden = 0;\n      if (rowsEl.scrollHeight > rowsEl.clientHeight + 1) {\n        noteEl.style.display = \"\";\n        noteEl.innerHTML = \"+99 more\";\n        for (var i = rows.length - 1; i >= 0 && rowsEl.scrollHeight > rowsEl.clientHeight + 1; i--) {\n          rows[i].remove(); hidden++;\n        }\n        noteEl.innerHTML = \"+\" + hidden + \" more &mdash; click a part to see only its alarms.\";\n      }\n    }\n    poll();\n\n    window.__cad = {\n      parts: function () { return Object.keys(PART).map(function (k) { return PART[k].name; }); },\n      alarms: function () { return ALARMS.slice(); },\n      selected: function () { return selected; },\n      filter: function () { return filter; },\n      kind: KIND,\n      // where a part sits on screen, for a headless click\n      screenPoint: function (name) {\n        var p = PART[name.toLowerCase()], b = new THREE.Box3(), c = new THREE.Vector3();\n        p.meshes.forEach(function (m) { b.expandByObject(m); });\n        b.getCenter(c).project(camera);\n        return { x: (c.x + 1) / 2 * window.innerWidth, y: (1 - c.y) / 2 * window.innerHeight };\n      }\n    };\n\n    var last = performance.now();\n    function frame(now) {\n      var dt = Math.min(0.1, (now - last) / 1000); last = now;\n      if (spin) { sph.theta += dt * 0.5; }\n      apply();\n      // Same fault look as the 3D cell: red emissive, pulsing while the alarm\n      // is unacknowledged, steady once it is acknowledged.\n      var pulse = 0.5 + 0.5 * Math.sin(now / 190);\n      Object.keys(PART).forEach(function (k) {\n        var p = PART[k], a = p.alarm;\n        var level = a ? (a.acked ? 0.6 : 0.25 + 0.55 * pulse) : 0;\n        p.meshes.forEach(function (m) {\n          m.material.emissive.setHex(a ? COL_FAULT : 0x000000);\n          m.material.emissiveIntensity = level;\n          m.material.color.setHex(p.name === selected && !a ? COL_SEL : m.userData.base);\n        });\n      });\n      renderer.render(scene, camera);\n      requestAnimationFrame(frame);\n    }\n    requestAnimationFrame(frame);\n\n    window.addEventListener(\"resize\", function () {\n      renderer.setSize(window.innerWidth, window.innerHeight);\n      layoutCamera();\n      renderAlarms();\n    });\n  }\n})();\n</script></body></html>\n"
}